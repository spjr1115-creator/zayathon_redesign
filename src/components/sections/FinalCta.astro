---
import { site } from '../../data/site';

const mail = `mailto:${site.contact.email}?subject=${encodeURIComponent(
  'Registration — ZAYATHON',
)}`;
---

<section class="s-final" id="register" aria-labelledby="final-title">
  <div class="container final-inner">
    
    <div class="final-top" data-reveal>
      <p class="section-label">08 / THE FINAL MOVE</p>
    </div>

    <div class="final-main">
      <h2 class="final-title" id="final-title" data-reveal style="--d: 200ms;">
        YOUR IDEA<br />
        STARTS HERE.
      </h2>
      
      <div class="final-copy" data-reveal style="--d: 400ms;">
        <p class="copy-primary">
          10 hours.<br />
          One team.<br />
          One problem worth solving.
        </p>
        <p class="copy-secondary">
          Stop waiting for the future.<br />
          Build something for it.
        </p>
      </div>

      <div class="final-actions" data-reveal style="--d: 600ms;">
        <a href="/register" class="btn-enter">
          ENTER ZAYATHON <span class="arrow">↗</span>
        </a>
        <a href={`mailto:${site.contact.email}`} class="micro-cta">
          Questions? &nbsp;{site.contact.email}
        </a>
      </div>
    </div>

    <div class="final-bottom">
      <div class="bottom-line-wrapper" data-reveal style="--d: 800ms;">
        <div class="animated-line"></div>
      </div>
      <p class="bottom-text" data-reveal style="--d: 1000ms;">
        BUILD. TEST. PRESENT.
      </p>
    </div>

  </div>
</section>

<style>
  .s-final {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: #111111;
    /* Subtle noise texture */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
    color: #F0F0EE;
    padding-top: clamp(80px, 12vh, 120px);
    padding-bottom: clamp(60px, 10vh, 80px);
    overflow: hidden;
  }

  .final-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    z-index: 2;
  }

  .final-top {
    margin-bottom: clamp(60px, 10vh, 100px);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgba(240, 240, 238, 0.5);
    text-transform: uppercase;
  }

  .final-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .final-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 9.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #F0F0EE;
    margin-bottom: clamp(40px, 6vh, 60px);
  }

  .final-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: clamp(50px, 8vh, 70px);
  }

  .copy-primary {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.4;
    color: rgba(240, 240, 238, 0.9);
  }

  .copy-secondary {
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    line-height: 1.5;
    color: rgba(240, 240, 238, 0.5);
  }

  .final-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .btn-enter {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #F0F0EE;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.65);
    padding: 0 40px;
    height: 64px;
    border-radius: 40px;
    text-decoration: none;
    transition: all 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-enter .arrow {
    font-family: var(--font-mono);
    font-size: 1.1em;
    transition: transform 300ms ease;
  }

  .micro-cta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(240, 240, 238, 0.4);
    text-decoration: none;
    transition: color 300ms ease;
    padding-left: 20px;
  }

  /* Hover States (Desktop) */
  @media (hover: hover) and (pointer: fine) {
    .btn-enter:hover {
      background: #F0F0EE;
      color: #111111;
      border-color: #F0F0EE;
    }
    
    .btn-enter:hover .arrow {
      transform: translateX(4px);
    }
    
    .micro-cta:hover {
      color: rgba(240, 240, 238, 0.9);
    }
  }

  /* Cinematic Bottom Line */
  .final-bottom {
    margin-top: clamp(80px, 15vh, 120px);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .bottom-line-wrapper {
    flex-grow: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
  }

  .animated-line {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: rgba(255, 255, 255, 0.4);
    transform-origin: left;
    /* Animation handled via data-reveal */
  }

  .bottom-text {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: rgba(240, 240, 238, 0.3);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  /* Scroll reveal logic */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUpFinal 800ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  .bottom-line-wrapper[data-reveal] {
    opacity: 1;
    transform: none;
    animation: none;
  }
  
  .bottom-line-wrapper[data-reveal] .animated-line {
    transform: scaleX(0);
    animation: drawLine 1500ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes fadeUpFinal {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes drawLine {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal], .bottom-line-wrapper[data-reveal] .animated-line, .btn-enter, .btn-enter .arrow {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Mobile tweaks */
  @media (max-width: 768px) {
    .btn-enter {
      width: 100%;
      justify-content: center;
      padding: 0 20px;
    }
    .micro-cta {
      padding-left: 0;
      align-self: center;
    }
    .final-bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 16px;
    }
    .bottom-line-wrapper {
      width: 100%;
    }
  }
</style>
