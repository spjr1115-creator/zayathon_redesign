---
import { site } from '../../data/site';

const videoSrc =
  'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260508_215831_c6a8989c-d716-4d8d-8745-e972a2eec711.mp4';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Cinematic backdrop: video, never hidden behind an opaque layer -->
  <video
    class="hero-video"
    src={videoSrc}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <!-- readability scrims only: top darkening, bottom gradient, vignette, grain -->
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="container-wide hero-frame">
    <!-- floating corner metadata -->
    <div class="hero-meta" aria-hidden="true">
      <div class="hero-meta__tl">
        <span class="hero-meta__name">ZAYATHON</span>
        <span class="hero-meta__org">ZAYA CODE HUB</span>
      </div>
      <div class="hero-meta__tr">
        <span>10 HOURS</span>
        <span>UP TO 4 MEMBERS</span>
      </div>
    </div>

    <!-- editorial headline, lower-left -->
    <div class="hero-content">
      <p class="hero-kicker anim" style="--delay:.2s">
        <span class="hero-kicker__rule" aria-hidden="true"></span>
        ZAYATHON {site.edition.replace('February', 'FEB')} · SALEM, INDIA
      </p>
      <h1 class="hero-title" id="hero-title">
        <span class="hero-line anim" style="--delay:.32s">BUILD WHAT</span>
        <span class="hero-line anim" style="--delay:.44s">THE FUTURE</span>
        <span class="hero-line anim" style="--delay:.56s">NEEDS<span class="hero-dot">.</span></span>
      </h1>
      <p class="hero-desc anim" style="--delay:.74s">
        A ten-hour student hackathon by ZAYA CODE HUB — teams of 2–4 turn one industry problem into a working product, mentored and judged in a single day, on-site in Salem.
      </p>
      
      <!-- CTA Buttons Row (Aligned on exact vertical baseline) -->
      <div class="hero-cta anim" style="--delay:.86s">
        <a class="btn btn--paper" href="/register">
          Register your team
          <svg class="arrow" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
        <a class="hero-cta__ghost" href="#domains">
          Explore domains
          <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </div>


    </div>

    <!-- scroll cue -->
    <a class="hero-scroll" href="#about">
      <span class="hero-scroll__label mono">Scroll to explore</span>
      <span class="hero-scroll__arrow" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  [hidden] {
    display: none !important;
  }

  .hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    overflow: clip;
    background: var(--night);
    color: var(--on-night);
  }

  /* ——— backdrop ——— */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.6) 0%,
        rgba(0, 0, 0, 0.35) 45%,
        rgba(0, 0, 0, 0.08) 100%
      ),
      linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.15) 45%,
        rgba(0, 0, 0, 0) 65%
      ),
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.35) 0%,
        rgba(0, 0, 0, 0.08) 22%,
        rgba(0, 0, 0, 0) 40%
      );
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 62%, rgba(0, 0, 0, 0.38) 100%);
  }

  .hero-grain {
    position: absolute;
    inset: -100px;
    opacity: 0.05;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='140' height='140' filter='url(%23n)'/></svg>");
  }

  /* ——— frame ——— */
  .hero-frame {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 92px;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    animation: hero-fade 900ms var(--ease-out) 0.05s both;
  }

  .hero-meta__tl,
  .hero-meta__tr {
    display: grid;
    gap: 3px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  .hero-meta__tl {
    text-align: left;
  }

  .hero-meta__tl .hero-meta__name {
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.32em;
  }

  .hero-meta__tr {
    text-align: right;
  }

  /* editorial headline */
  .hero-content {
    margin-top: auto;
    margin-bottom: clamp(40px, 6vh, 80px);
    max-width: 900px;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(34px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .anim {
    opacity: 0;
    animation: hero-rise 900ms var(--ease-out) forwards;
    animation-delay: var(--delay, 0s);
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 26px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  .hero-kicker__rule {
    width: 34px;
    height: 1px;
    background: var(--blue);
  }

  .hero-title {
    display: grid;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.28), 0 2px 24px rgba(0, 0, 0, 0.22);
  }

  .hero-line {
    font-size: var(--display-hero);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.03em;
    width: max-content;
  }

  .hero-dot {
    color: var(--blue);
  }

  .hero-desc {
    margin-top: 30px;
    max-width: 46ch;
    font-size: var(--lead);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 400;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
  }

  /* CTA Row Alignment — 54px box height & vertical centering for exact baseline alignment */
  .hero-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 38px;
  }

  .hero-cta .btn--paper {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .hero-cta__ghost {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 54px;
    min-height: 48px;
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid transparent;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-micro) var(--ease-out), border-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-cta__ghost:hover {
      color: var(--blue);
      border-bottom-color: currentColor;
    }

    .hero-scroll:hover {
      color: #ffffff;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .hero-cta .btn--paper:active,
    .hero-cta__ghost:active {
      transform: scale(0.97);
      opacity: 0.88;
      transition: transform 120ms var(--ease-out), opacity 120ms var(--ease-out);
    }
  }

  /* scroll cue */
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    min-height: 44px;
    min-width: 44px;
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-micro) var(--ease-out);
    animation: hero-fade 900ms var(--ease-out) 1.1s both;
  }

  .hero-scroll__label {
    font-size: 0.56rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: center;
  }

  .hero-scroll__arrow {
    font-size: 0.8rem;
    animation: scroll-nudge 2.4s var(--ease-out) infinite;
  }

  @keyframes scroll-nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* responsive */
  @media (max-width: 900px) {
    .hero-meta__tr {
      display: none;
    }

    .hero-line {
      width: auto;
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 640px;
    }

    .hero-frame {
      padding-top: 88px;
    }

    .hero-meta__tl {
      font-size: 0.54rem;
    }

    .hero-line {
      font-size: clamp(2.2rem, 8vw, 4rem);
      width: 100%;
      word-break: break-word;
    }

    .hero-content {
      margin-bottom: 88px;
    }

    .hero-desc {
      font-size: 1.02rem;
    }

    .hero-cta {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      margin-top: 30px;
    }

    .hero-cta .btn--paper,
    .hero-cta__ghost {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll__arrow {
      animation: none;
    }

    .anim {
      animation-duration: 0.01ms;
      opacity: 1;
    }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  // Autoplay video handler
  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  if (video) {
    const tryPlay = () => video.play().catch(() => {});
    if (video.readyState >= 1) tryPlay();
    else video.addEventListener('loadedmetadata', tryPlay, { once: true });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) tryPlay();
    });
    document.addEventListener('click', tryPlay, { once: true });
  }

</script>
