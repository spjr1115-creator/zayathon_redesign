---
const prizes = [
  {
    index: '01',
    amount: 3000,
    title: 'GRAND CHAMPION',
    perks: ['CASH PRIZE', 'INTERNSHIP OPPORTUNITY', 'GOODIES & SWAGS', 'CERTIFICATE'],
    isGrand: true
  },
  {
    index: '02',
    amount: 2000,
    title: 'FIRST RUNNER UP',
    perks: ['CASH PRIZE', 'GOODIES & SWAGS', 'CERTIFICATE'],
    isGrand: false
  },
  {
    index: '03',
    amount: 1000,
    title: 'SECOND RUNNER UP',
    perks: ['CASH PRIZE', 'GOODIES & SWAGS', 'CERTIFICATE'],
    isGrand: false
  }
];

const beyond = [
  'INTERNSHIP OPPORTUNITY',
  'GOODIES & SWAGS',
  'CERTIFICATE'
];
---

<section class="section s-reward" id="prizes" aria-labelledby="reward-title">
  <div class="container">
    <div class="reward-layout">
      
      <!-- LEFT/TOP: Editorial Headers -->
      <header class="reward-head" data-reveal>
        <p class="section-label">05 / THE REWARD</p>
        <h2 class="reward-title" id="reward-title">
          WHAT'S<br />
          AT STAKE?
        </h2>
        <p class="reward-desc">
          Build something worth remembering.<br />
          Then make it worth winning.
        </p>
      </header>

      <!-- RIGHT/BOTTOM: Prizes -->
      <div class="reward-content">
        
        <div class="prizes-list" id="prizes-trigger">
          {prizes.map((prize, i) => (
            <div class={`prize-row ${prize.isGrand ? 'prize-grand' : ''}`} data-reveal style={`--d: ${i * 150}ms;`}>
              <div class="prize-main">
                <span class="prize-num mono" aria-hidden="true">{prize.index}</span>
                
                <div class="prize-amount-group">
                  <div class="prize-particles" aria-hidden="true">
                    <span>₹</span><span>0</span><span>+</span><span>1</span><span>₹</span>
                  </div>
                  <span class="prize-currency">₹</span>
                  <span class="prize-amount" data-target={prize.amount} data-delay={i * 150}>0</span>
                </div>
                
                <h3 class="prize-title">{prize.title}</h3>
              </div>
              
              <div class="prize-perks-wrapper">
                <ul class="prize-perks mono">
                  {prize.perks.map(perk => (
                    <li>{perk}</li>
                  ))}
                </ul>
              </div>
              
              <div class="prize-divider"></div>
            </div>
          ))}
        </div>
        
        <!-- BEYOND THE PRIZE -->
        <div class="beyond-section" data-reveal style="--d: 600ms;">
          <p class="beyond-label mono">BEYOND THE PRIZE</p>
          <div class="beyond-divider"></div>
          <ul class="beyond-list mono">
            {beyond.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .s-reward {
    background-color: #F0F0EE;
    color: #111111;
    padding-top: clamp(100px, 15vh, 180px);
    padding-bottom: clamp(100px, 15vh, 180px);
    overflow: hidden;
  }

  .reward-layout {
    display: flex;
    flex-direction: row;
    gap: clamp(60px, 8vw, 120px);
    align-items: flex-start;
  }

  /* --- LEFT: Header --- */
  .reward-head {
    flex: 0 0 35%;
    position: sticky;
    top: 120px;
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #777777;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .reward-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 30px;
  }

  .reward-desc {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    color: #555555;
    max-width: 30ch;
  }

  /* --- RIGHT: Content --- */
  .reward-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-top: 10px;
  }

  .prizes-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 80px;
  }

  /* Prize Row */
  .prize-row {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .prize-main {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .prize-num {
    font-size: 0.8rem;
    color: #777777;
    margin-bottom: 16px;
    transition: color 300ms ease;
  }

  /* Hierarchy typography */
  .prize-amount-group {
    position: relative;
    display: flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: #111111;
    margin-bottom: 20px;
    transition: transform 300ms ease;
    cursor: default;
  }

  .prize-currency {
    margin-right: 4px;
    color: rgba(17, 17, 17, 0.8);
  }

  .prize-amount {
    font-variant-numeric: tabular-nums;
  }

  .prize-title {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 20px;
  }

  /* Base sizes (2nd, 3rd place) */
  .prize-currency { font-size: clamp(2rem, 3.5vw, 3.5rem); }
  .prize-amount { font-size: clamp(3.5rem, 7vw, 7rem); }
  .prize-title { font-size: clamp(1.4rem, 2.5vw, 2.5rem); }

  /* Grand Champion overrides */
  .prize-grand .prize-currency { font-size: clamp(3rem, 5vw, 5rem); }
  .prize-grand .prize-amount { font-size: clamp(5rem, 11vw, 11rem); color: var(--blue); }
  .prize-grand .prize-title { font-size: clamp(1.8rem, 3.5vw, 3.5rem); }
  
  .prize-grand .prize-num {
    color: var(--blue);
  }

  /* Perks List */
  .prize-perks-wrapper {
    overflow: hidden;
    margin-bottom: 40px;
  }

  .prize-perks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: 0.7;
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .prize-perks li {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #555555;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .prize-perks li::before {
    content: '';
    display: block;
    width: 4px;
    height: 4px;
    background: #111;
    border-radius: 50%;
    opacity: 0.3;
  }

  .prize-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(17, 17, 17, 0.12);
  }

  /* Hover interactions (Desktop) */
  @media (hover: hover) and (pointer: fine) {
    .prize-row:hover .prize-amount-group {
      transform: scale(1.02);
      transform-origin: left bottom;
    }
    
    .prize-row:hover .prize-num {
      color: var(--blue);
    }
    
    .prize-row:hover .prize-perks {
      opacity: 1;
      transform: translateX(5px);
    }
    
    .prize-row:hover .prize-perks li {
      color: #111;
    }
    
    .prize-row:hover .prize-perks li::before {
      background: var(--blue);
      opacity: 1;
    }
  }

  /* Beyond the Prize Section */
  .beyond-section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .beyond-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #777777;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .beyond-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(17, 17, 17, 0.12);
    margin-bottom: 30px;
  }

  .beyond-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
  }

  .beyond-list li {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #111;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: transform 300ms ease, color 300ms ease;
    cursor: default;
  }
  
  .beyond-list li::before {
    content: '→';
    color: var(--blue);
    transition: transform 300ms ease;
  }

  /* Beyond the Prize Hover Interactions */
  @media (hover: hover) and (pointer: fine) {
    .beyond-list li:hover {
      transform: translateX(8px);
      color: var(--blue);
    }
    .beyond-list li:hover::before {
      transform: translateX(4px);
    }
  }

  /* Financial Particles Effect (Active only during animation) */
  .prize-particles {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    opacity: 0; /* Hidden by default */
    transition: opacity 300ms ease;
  }
  
  .prize-particles.is-active {
    opacity: 0.4;
  }

  .prize-particles span {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--blue);
  }
  
  .prize-particles span:nth-child(1) { top: -10%; left: 10%; animation: float 2s infinite linear; }
  .prize-particles span:nth-child(2) { top: 110%; left: 80%; animation: float 2.5s infinite linear reverse; }
  .prize-particles span:nth-child(3) { top: 80%; left: 5%; animation: float 2.2s infinite linear; }
  .prize-particles span:nth-child(4) { top: -20%; left: 90%; animation: float 2.8s infinite linear reverse; }
  .prize-particles span:nth-child(5) { top: 30%; left: -5%; animation: float 2.1s infinite linear; }

  @keyframes float {
    0% { transform: translate(0, 0); opacity: 0; }
    50% { transform: translate(10px, -10px); opacity: 1; }
    100% { transform: translate(20px, 0); opacity: 0; }
  }

  /* Mobile tweaks */
  @media (max-width: 980px) {
    .reward-layout {
      flex-direction: column;
      gap: 60px;
    }
    
    .reward-head {
      position: relative;
      top: 0;
      flex: none;
    }
    
    .prize-particles {
      display: none !important; /* Reduce noise on mobile */
    }

    .beyond-list {
      flex-direction: column;
      gap: 20px;
    }
  }

  /* Scroll reveal generic */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUpRow 600ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes fadeUpRow {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal], .prize-row, .prize-amount-group, .prize-perks {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Animated Counters Logic
  const triggerSection = document.getElementById('prizes-trigger');
  const amounts = document.querySelectorAll('.prize-amount');
  
  if (amounts.length > 0 && triggerSection) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hasAnimated = false;

    // Formatting helper (e.g. 3000 -> 3,000)
    const formatNumber = (num) => {
      return num.toLocaleString('en-IN');
    };

    const runAnimation = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      amounts.forEach(amountElement => {
        const targetValue = parseInt(amountElement.getAttribute('data-target') || '0', 10);
        const delay = parseInt(amountElement.getAttribute('data-delay') || '0', 10);
        const particles = amountElement.parentElement.querySelector('.prize-particles');
        
        if (prefersReducedMotion) {
          amountElement.innerText = formatNumber(targetValue);
          return;
        }

        setTimeout(() => {
          const duration = 1800; // ~1.8 seconds per counter
          const startTime = performance.now();
          
          if (particles) particles.classList.add('is-active');
          
          const easeOutExpo = (t) => {
            return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
          };

          const animate = (currentTime) => {
            const elapsedTime = currentTime - startTime;
            let progress = Math.min(elapsedTime / duration, 1);
            
            const easedProgress = easeOutExpo(progress);
            const currentValue = Math.floor(easedProgress * targetValue);
            
            amountElement.innerText = formatNumber(currentValue);

            if (progress < 1) {
              requestAnimationFrame(animate);
            } else {
              amountElement.innerText = formatNumber(targetValue);
              if (particles) particles.classList.remove('is-active'); // Fade particles out
            }
          };

          requestAnimationFrame(animate);
        }, delay);
      });
    };

    // Intersection Observer to trigger once
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasAnimated) {
          runAnimation();
          observer.disconnect(); // Only run once
        }
      });
    }, { threshold: 0.2 });

    observer.observe(triggerSection);
  }
</script>
