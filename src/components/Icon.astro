---

<svg
  viewBox="0 0 24 24"
  width:list={[size]}
  height:list={[size]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[className]}
  set:html={glyphs[name]}
/>
