---
import { navLinks, site } from '../data/site';
---

<header class="site-header" id="site-header">
  <div class="container-wide nav-row">
    <!-- Left pill · circular logo -->
    <a class="pill pill--logo" href="#top" aria-label="ZAYATHON — back to top">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square">
          <path d="M4 5h16v3L13 19h7" />
        </svg>
      </span>
    </a>

    <!-- Right pill · links + register -->
    <nav class="pill pill--links" aria-label="Primary">
      <ul class="nav-list" role="list">
        {navLinks.map((l) => (
          <li>
            <a class="nav-link" href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a class="nav-reg" href="/register">
        Register
        <svg class="arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9.5 4l4 4-4 4" /></svg>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </nav>
  </div>

  <!-- Mobile menu backdrop -->
  <div class="nav-backdrop" id="nav-backdrop" hidden></div>

  <!-- Mobile menu -->
  <div class="nav-menu" id="nav-menu" hidden>
    <ul role="list">
      {navLinks.map((l) => (
        <li>
          <a class="nav-menu__link" href={l.href}>
            <span>{l.label}</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn--primary nav-menu__cta" href="/register">Register your team</a>
    <p class="nav-menu__contact mono">
      {site.contact.email} · {site.contact.phoneDisplay}
    </p>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 120;
    pointer-events: none;
  }

  .nav-row {
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 18px;
  }

  /* shared pill anatomy */
  .pill {
    position: relative;
    z-index: 135;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    background: var(--pill, #ededed);
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    box-shadow: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* after the hero, pills lift slightly over the paper page */
  .site-header.is-scrolled .pill {
    border-color: var(--line-soft);
    box-shadow: var(--shadow-float);
  }

  .pill--logo {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    justify-content: center;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }

  .pill--logo:hover .logo-mark {
    background: var(--blue);
  }

  .pill--links {
    gap: 2px;
    padding: 5px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 9px 11px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-radius: var(--r-pill);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--blue);
  }

  .nav-reg {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    margin-left: 6px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .nav-reg:hover {
    background: var(--blue);
    transform: translateX(2px);
  }

  .nav-reg .arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav-reg:hover .arrow {
    transform: translateX(2px);
  }

  /* mobile toggle */
  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4.5px;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    margin-left: 4px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .menu-btn span {
    width: 16px;
    height: 1.7px;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .menu-btn[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(3.1px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(-3.1px) rotate(-45deg);
  }

  /* mobile backdrop */
  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 125;
    pointer-events: auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-backdrop[hidden] {
    display: none !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  /* mobile dropdown */
  .nav-menu {
    position: fixed;
    top: 76px;
    left: 16px;
    right: 16px;
    width: auto;
    max-width: 440px;
    margin-inline: auto;
    max-height: calc(100vh - 92px);
    max-height: calc(100dvh - 92px);
    overflow-y: auto;
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.14);
    border-radius: 22px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
    padding: 24px;
    z-index: 130;
    pointer-events: auto;
    -webkit-overflow-scrolling: touch;
  }

  .nav-menu[hidden] {
    display: none !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  .nav-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 6px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink, #111111);
    min-height: 48px;
    pointer-events: auto;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  .nav-menu__link svg {
    color: var(--ink-3, #777777);
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--blue);
    }

    .nav-reg:hover {
      background: var(--blue);
      transform: translateX(2px);
    }

    .nav-reg:hover .arrow {
      transform: translateX(2px);
    }

    .pill--logo:hover .logo-mark {
      background: var(--blue);
    }

    .nav-menu__link:hover {
      color: var(--blue, #1d4ed8);
    }

    .nav-menu__link:hover svg {
      transform: translateX(4px);
      color: var(--blue, #1d4ed8);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .menu-btn:active,
    .nav-menu__link:active,
    .nav-reg:active,
    .pill--logo:active {
      transform: scale(0.97);
      opacity: 0.88;
      transition: transform 120ms var(--ease-out), opacity 120ms var(--ease-out);
    }
  }

  .nav-menu__cta {
    width: 100%;
    margin-top: 18px;
    min-height: 48px;
    pointer-events: auto;
    cursor: pointer;
    touch-action: manipulation;
  }

  .nav-menu__contact {
    margin-top: 14px;
    text-align: center;
    font-size: 0.7rem;
    color: var(--ink-3, #777777);
    letter-spacing: 0.02em;
  }

  @media (max-width: 1060px) {
    .nav-list {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }
  }

  @media (max-width: 520px) {
    .nav-reg {
      display: inline-flex;
      padding: 0 12px;
      font-size: 0.68rem;
      margin-left: 2px;
      min-height: 44px;
      height: 44px;
    }
  }
</style>

<script>
  const header   = document.getElementById('site-header');
  const toggle   = header?.querySelector<HTMLButtonElement>('.menu-btn');
  const menu     = header?.querySelector<HTMLElement>('#nav-menu');
  const backdrop = header?.querySelector<HTMLElement>('#nav-backdrop');

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 48);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
    if (backdrop) backdrop.hidden = true;
    toggle.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
  }

  function openMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'true');
    menu.hidden = false;
    if (backdrop) backdrop.hidden = false;
    toggle.setAttribute('aria-label', 'Close menu');
    document.body.style.overflow = 'hidden';
  }

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  backdrop?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      closeMenu();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      closeMenu();
    }
  });

  document.addEventListener('click', (e) => {
    if (menu && !menu.hidden && header && !header.contains(e.target as Node)) {
      closeMenu();
    }
  });
</script>
