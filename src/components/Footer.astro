---
import { site } from '../data/site';

const contactMail = `mailto:${site.contact.email}`;
---

<footer class="site-footer">
  <div class="container footer-inner">
    
    <!-- Links Row -->
    <nav class="footer-nav" aria-label="Footer Navigation">
      <ul class="nav-list mono">
        <li><a href="#about">ABOUT</a></li>
        <li><a href="#domains">TRACKS</a></li>
        <li><a href="#timeline">TIMELINE</a></li>
        <li><a href="#prizes">PRIZES</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href={contactMail}>CONTACT</a></li>
      </ul>
    </nav>

    <!-- Main Footer Grid -->
    <div class="footer-grid">
      <div class="footer-col left">
        <p class="brand">ZAYATHON</p>
        <p class="sub-brand">{site.org}</p>
      </div>
      
      <div class="footer-col center">
        <p class="edition">ZAYATHON 2026</p>
      </div>
      
      <div class="footer-col right">
        <p class="location">SALEM, TAMIL NADU</p>
        <p class="country">INDIA</p>
      </div>
    </div>

    <!-- Copyright Row -->
    <div class="footer-copyright mono">
      <p>© {site.copyrightYear} {site.org}</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background-color: #111111;
    color: #F0F0EE;
    /* Use the same subtle noise texture to perfectly blend with the Final Move section above */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
    padding-top: clamp(40px, 8vh, 80px);
    padding-bottom: clamp(40px, 8vh, 60px);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 8vh, 80px);
  }

  /* Navigation Links */
  .footer-nav {
    display: flex;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: clamp(30px, 6vh, 50px);
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px clamp(30px, 5vw, 60px);
  }

  .nav-list a {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: rgba(240, 240, 238, 0.5);
    text-decoration: none;
    text-transform: uppercase;
    transition: all 300ms ease;
    position: relative;
    padding-bottom: 4px;
  }

  /* Main Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: end;
    gap: 30px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-col.center {
    align-items: center;
    text-align: center;
  }

  .footer-col.right {
    align-items: flex-end;
    text-align: right;
  }

  .brand, .edition, .location {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(240, 240, 238, 0.9);
    text-transform: uppercase;
  }

  .sub-brand, .country {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: rgba(240, 240, 238, 0.4);
    text-transform: uppercase;
  }

  /* Copyright */
  .footer-copyright {
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }

  .footer-copyright p {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: rgba(240, 240, 238, 0.3);
    text-transform: uppercase;
  }

  /* Hover States (Desktop) */
  @media (hover: hover) and (pointer: fine) {
    .nav-list a::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 1px;
      background: rgba(240, 240, 238, 0.9);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 300ms ease;
    }
    
    .nav-list a:hover {
      color: rgba(240, 240, 238, 0.9);
    }
    
    .nav-list a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  /* Mobile Tweaks */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      align-items: center;
      text-align: center;
      gap: 40px;
    }
    
    .footer-col.left, .footer-col.right {
      align-items: center;
      text-align: center;
    }
    
    .nav-list {
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }
  }
</style>
