---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import PublicCountdown from '../components/sections/PublicCountdown.astro';
import About from '../components/sections/About.astro';
import StatsBand from '../components/sections/StatsBand.astro';
import Domains from '../components/sections/Domains.astro';
import Why from '../components/sections/Why.astro';
import Timeline from '../components/sections/Timeline.astro';
import Prizes from '../components/sections/Prizes.astro';
import Sponsors from '../components/sections/Sponsors.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <PublicCountdown />
    <About />
    <StatsBand />
    <Domains />
    <Why />
    <Timeline />
    <Prizes />
    <Sponsors />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
