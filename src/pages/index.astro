---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import PublicCountdown from '../components/sections/PublicCountdown.astro';
import About from '../components/sections/About.astro';
import StatsBand from '../components/sections/StatsBand.astro';
import Domains from '../components/sections/Domains.astro';
import Why from '../components/sections/Why.astro';
import Timeline from '../components/sections/Timeline.astro';
import Prizes from '../components/sections/Prizes.astro';
import Sponsors from '../components/sections/Sponsors.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "ZAYATHON 2026",
  "startDate": "2026-02-10T08:00:00+05:30",
  "endDate": "2026-02-10T18:00:00+05:30",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "eventStatus": "https://schema.org/EventScheduled",
  "location": {
    "@type": "Place",
    "name": "Sona College of Technology",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Salem",
      "addressRegion": "Tamil Nadu",
      "addressCountry": "IN"
    }
  },
  "image": ["https://zayathon-xi.vercel.app/og-image.png"],
  "description": "ZAYATHON 2026 is a 10-hour student hackathon by ZAYA CODE HUB, bringing teams together to build innovative solutions across AI, robotics, cybersecurity, healthtech, fintech and more.",
  "organizer": {
    "@type": "Organization",
    "name": "ZAYA CODE HUB",
    "url": "https://zayathon-xi.vercel.app/"
  }
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <main id="main">
    <Hero />
    <PublicCountdown />
    <About />
    <StatsBand />
    <Domains />
    <Why />
    <Timeline />
    <Prizes />
    <Sponsors />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
