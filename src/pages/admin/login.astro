---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="admin-login-page">
    <header class="admin-nav">
      <div class="nav-inner container-wide">
        <span class="nav-brand">ZAYATHON</span>
        <a href="/" class="back-link">
          <span class="arrow">←</span> BACK TO WEBSITE
        </a>
      </div>
    </header>

    <div class="container login-container">
      <div class="login-wrapper">
        
        <div class="login-header">
          <p class="section-label mono">ZAYATHON / CONTROL</p>
          <h1 class="login-title">ADMIN ACCESS</h1>
          <p class="login-subtitle">Manage registrations. Keep the build moving.</p>
        </div>

        <form id="admin-login-form" class="login-form">
          
          <div id="login-error" class="login-error" aria-live="assertive" hidden></div>

          <div class="field-group">
            <label for="email">EMAIL <span class="req">*</span></label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="admin@zayathon.com"
              autocomplete="email"
            />
          </div>

          <div class="field-group">
            <label for="password">PASSWORD <span class="req">*</span></label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              placeholder="••••••••••••"
              autocomplete="current-password"
            />
          </div>

          <button type="submit" id="btn-login" class="btn-submit">
            SIGN IN <span class="arrow">↗</span>
          </button>
        </form>

        <footer class="login-footer mono">
          <span>ZAYATHON 2026</span>
          <span class="dot">•</span>
          <span>ZAYA CODE HUB</span>
        </footer>

      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .admin-login-page {
    background-color: #F0F0EE;
    color: #111111;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans, 'Inter', sans-serif);
  }

  .admin-nav {
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding: 24px 0;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .back-link {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: #777777;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 250ms ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .back-link:hover {
    color: var(--blue, #1d4ed8);
  }

  .back-link .arrow {
    transition: transform 250ms ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-4px);
  }

  .login-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
  }

  .login-wrapper {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: #777777;
    margin-bottom: 12px;
  }

  .login-title {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 12px;
  }

  .login-subtitle {
    font-size: 1rem;
    color: #555555;
    line-height: 1.5;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #555555;
    text-transform: uppercase;
  }

  .req {
    color: var(--blue, #1d4ed8);
  }

  input[type="email"],
  input[type="password"] {
    width: 100%;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 10px;
    height: 54px;
    padding: 0 16px;
    font-size: 15px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    color: #111111;
    transition: border-color 250ms ease, box-shadow 250ms ease;
    appearance: none;
  }

  input:focus {
    outline: none;
    border-color: var(--blue, #1d4ed8);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
  }

  .login-error {
    background: rgba(220, 38, 38, 0.06);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 8px;
    padding: 16px;
    color: #dc2626;
    font-size: 0.88rem;
    line-height: 1.5;
    white-space: pre-line;
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-top: 12px;
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    background: #111111;
    border: none;
    height: 56px;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 250ms ease;
  }

  .btn-submit:hover:not(:disabled) {
    background: #333333;
  }

  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .login-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: #999999;
    text-transform: uppercase;
    padding-top: 16px;
    border-top: 1px solid rgba(17, 17, 17, 0.08);
  }

  @media (max-width: 480px) {
    .login-container {
      padding: 32px 16px;
    }
    .login-wrapper {
      gap: 28px;
    }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

  if (!supabaseUrl || !supabaseKey) {
    throw new Error(
      'Missing Supabase configuration. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_KEY.'
    );
  }

  const supabase = createClient(supabaseUrl, supabaseKey);

  const form = document.getElementById('admin-login-form') as HTMLFormElement;
  const errorBox = document.getElementById('login-error') as HTMLDivElement;
  const btnLogin = document.getElementById('btn-login') as HTMLButtonElement;

  // On page load, check if session exists and is authorized admin
  async function checkExistingSession() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      const isAuthorized = await verifyAdminUser(session.user.id, session.user.email);
      if (isAuthorized) {
        window.location.href = '/admin';
      }
    }
  }

  async function verifyAdminUser(userId: string, email?: string): Promise<boolean> {
    try {
      const { data, error } = await supabase
        .from('admin_users')
        .select('*');

      if (error || !data || data.length === 0) {
        return false;
      }

      // Match user_id or email or single admin record
      return data.some((row: any) => 
        row.user_id === userId || 
        (email && row.email === email) || 
        row.id === userId
      );
    } catch {
      return false;
    }
  }

  checkExistingSession();

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (errorBox) errorBox.hidden = true;

      const originalBtnText = btnLogin.innerHTML;
      btnLogin.disabled = true;
      btnLogin.innerHTML = 'SIGNING IN...';

      const formData = new FormData(form);
      const email = String(formData.get('email') || '').trim();
      const password = String(formData.get('password') || '');

      try {
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error || !data.user) {
          throw new Error('Invalid email or password. Please check your credentials.');
        }

        // Verify admin authorization
        const isAuthorized = await verifyAdminUser(data.user.id, data.user.email);

        if (!isAuthorized) {
          await supabase.auth.signOut();
          if (errorBox) {
            errorBox.textContent = 'ACCESS DENIED\n\nYou do not have permission to access the ZAYATHON admin dashboard.';
            errorBox.hidden = false;
          }
          btnLogin.disabled = false;
          btnLogin.innerHTML = originalBtnText;
          return;
        }

        // Redirect to admin dashboard
        window.location.href = '/admin';

      } catch (err: any) {
        if (errorBox) {
          errorBox.textContent = err?.message || 'Authentication failed. Please try again.';
          errorBox.hidden = false;
        }
        btnLogin.disabled = false;
        btnLogin.innerHTML = originalBtnText;
      }
    });
  }
</script>
