</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

  if (!supabaseUrl || !supabaseKey) {
    throw new Error(
      'Missing Supabase configuration. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_KEY.'
    );
  }

  const supabase = createClient(supabaseUrl, supabaseKey);

  // HTML Escape Helper
  function escapeHtml(str: string | null | undefined): string {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[char]!));
  }

  // CSV Value Escape Helper
  function escapeCsv(val: string | null | undefined): string {
    if (val === null || val === undefined) return '""';
    const str = String(val);
    const escaped = str.replace(/"/g, '""');
    return `"${escaped}"`;
  }

  interface Registration {
    id: string;
    team_name: string;
    problem_domain: string;
    leader_name: string;
    leader_email: string;
    leader_phone: string;
    leader_college: string;
    leader_year: string;
    member_2_name?: string | null;
    member_2_email?: string | null;
    member_2_phone?: string | null;
    member_3_name?: string | null;
    member_3_email?: string | null;
    member_3_phone?: string | null;
    member_4_name?: string | null;
    member_4_email?: string | null;
    member_4_phone?: string | null;
    created_at: string;
  }

  // State Variables
  let isLoading = true;
  let loadError = false;
  let registrations: Registration[] = [];
  let filteredRegistrations: Registration[] = [];
  let selectedRegistration: Registration | null = null;
  let activeEventClock: any = null;
  let adminTimerInterval: any = null;

  // DOM Elements
  const btnSignOut = document.getElementById('btn-signout');
  const btnExportCsv = document.getElementById('btn-export-csv') as HTMLButtonElement;
  const statTotalTeams = document.getElementById('stat-total-teams');
  const statTotalMembers = document.getElementById('stat-total-members');
  const statDomains = document.getElementById('stat-domains');

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const domainFilter = document.getElementById('domain-filter') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;

  const stateLoading = document.getElementById('state-loading');
  const stateError = document.getElementById('state-error');
  const stateEmpty = document.getElementById('state-empty');
  const tableWrapper = document.getElementById('table-wrapper');
  const tbody = document.getElementById('registrations-tbody');

  const btnRetry = document.getElementById('btn-retry');

  const detailModal = document.getElementById('detail-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const modalTeamName = document.getElementById('modal-team-name');
  const modalBody = document.getElementById('modal-body');

  // Event Control DOM
  const eventForm = document.getElementById('event-control-form') as HTMLFormElement;
  const eventError = document.getElementById('event-error');
  const btnStopCountdown = document.getElementById('btn-stop-countdown');

  // ── Session & Authorization Check ─────────────────────────────────────────
  async function initAdminDashboard() {
    closeDetailModal();

    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      window.location.href = '/admin/login';
      return;
    }

    const isAuthorized = await verifyAdmin(session.user.id, session.user.email);
    if (!isAuthorized) {
      await supabase.auth.signOut();
      window.location.href = '/admin/login';
      return;
    }

    // Load registrations & event clock only after authorized
    await Promise.all([
      fetchRegistrations(),
      fetchEventClock()
    ]);
  }

  async function verifyAdmin(userId: string, email?: string): Promise<boolean> {
    try {
      const { data, error } = await supabase
        .from('admin_users')
        .select('*');

      if (error || !data || data.length === 0) {
        return false;
      }

      return data.some((row: any) => 
        row.user_id === userId || 
        (email && row.email === email) || 
        row.id === userId
      );
    } catch {
      return false;
    }
  }

  // ── Event Control Handlers ────────────────────────────────────────────────
  function parseISTDateTime(dateVal: string, timeVal: string): Date | null {
    if (!dateVal || !timeVal) return null;
    const isoIST = `${dateVal}T${timeVal}:00+05:30`;
    const d = new Date(isoIST);
    if (isNaN(d.getTime())) return null;
    return d;
  }

  function formatISTDisplay(d: Date): string {
    const formatted = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Kolkata',
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: true
    }).format(d);
    return formatted.toUpperCase().replace(',', ' ·') + ' IST';
  }

  function updateTargetPreview() {
    const eventNameInput = document.getElementById('event-name') as HTMLInputElement;
    const eventDateInput = document.getElementById('event-date') as HTMLInputElement;
    const eventTimeInput = document.getElementById('event-time') as HTMLInputElement;
    const previewNameEl = document.getElementById('preview-event-name');
    const previewTimeEl = document.getElementById('preview-target-time');

    const nameVal = (eventNameInput?.value || '').trim() || 'REGISTRATION OPENS';
    const dateVal = eventDateInput?.value || '';
    const timeVal = eventTimeInput?.value || '';

    if (previewNameEl) previewNameEl.textContent = nameVal.toUpperCase();

    const istDate = parseISTDateTime(dateVal, timeVal);
    if (istDate) {
      if (previewTimeEl) previewTimeEl.textContent = formatISTDisplay(istDate);
    } else {
      if (previewTimeEl) previewTimeEl.textContent = 'SELECT DATE & TIME TO PREVIEW TARGET';
    }
  }

  async function fetchEventClock() {
    try {
      const { data, error } = await supabase
        .from('event_clock')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(1)
        .maybeSingle();

      if (error && error.code !== 'PGRST116') {
        console.error('Failed to fetch event clock:', error);
        return;
      }

      activeEventClock = data;
      renderAdminEventControl();
    } catch (err) {
      console.error('Error fetching event clock:', err);
    }
  }

  function renderAdminEventControl() {
    const badge = document.getElementById('event-state-badge');
    const displayBox = document.getElementById('active-event-display');
    const nameEl = document.getElementById('active-event-name');
    const descDisplayEl = document.getElementById('active-event-desc-display');
    const targetEl = document.getElementById('active-event-target');

    const eventNameInput = document.getElementById('event-name') as HTMLInputElement;
    const eventDescInput = document.getElementById('event-desc') as HTMLInputElement;
    const eventDateInput = document.getElementById('event-date') as HTMLInputElement;
    const eventTimeInput = document.getElementById('event-time') as HTMLInputElement;

    if (!activeEventClock || !activeEventClock.is_active) {
      if (badge) {
        badge.textContent = '○ COUNTDOWN INACTIVE';
        badge.className = 'state-badge mono inactive';
      }
      if (displayBox) displayBox.hidden = true;
      if (adminTimerInterval) clearInterval(adminTimerInterval);
      return;
    }

    // Active event exists
    if (badge) {
      badge.textContent = '● COUNTDOWN ACTIVE';
      badge.className = 'state-badge mono active';
    }
    if (displayBox) displayBox.hidden = false;

    if (nameEl) nameEl.textContent = activeEventClock.event_name.toUpperCase();
    
    if (descDisplayEl) {
      if (activeEventClock.event_description && activeEventClock.event_description.trim()) {
        descDisplayEl.textContent = activeEventClock.event_description;
        descDisplayEl.hidden = false;
      } else {
        descDisplayEl.hidden = true;
      }
    }

    const targetDate = new Date(activeEventClock.target_time);
    const formattedIST = formatISTDisplay(targetDate);

    if (targetEl) targetEl.textContent = `TARGET: ${formattedIST}`;

    // Prefill form values for convenience
    if (eventNameInput && !eventNameInput.value) {
      eventNameInput.value = activeEventClock.event_name;
    }
    if (eventDescInput && !eventDescInput.value && activeEventClock.event_description) {
      eventDescInput.value = activeEventClock.event_description;
    }

    if (targetDate && (!eventDateInput?.value || !eventTimeInput?.value)) {
      try {
        const ymd = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Asia/Kolkata',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).format(targetDate);

        const hm = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false
        }).format(targetDate);

        if (eventDateInput && !eventDateInput.value) eventDateInput.value = ymd;
        if (eventTimeInput && !eventTimeInput.value) eventTimeInput.value = hm;
      } catch (err) {
        console.error('Error prefilling date/time inputs:', err);
      }
    }

    updateTargetPreview();
    startAdminTimer(targetDate.getTime());
  }

  function startAdminTimer(targetMs: number) {
    if (adminTimerInterval) clearInterval(adminTimerInterval);

    const updateAdminTimer = () => {
      const daysEl = document.getElementById('admin-cd-days');
      const hoursEl = document.getElementById('admin-cd-hours');
      const minsEl = document.getElementById('admin-cd-minutes');
      const secsEl = document.getElementById('admin-cd-seconds');

      const now = Date.now();
      const diff = targetMs - now;

      if (diff <= 0) {
        if (daysEl) daysEl.textContent = '00';
        if (hoursEl) hoursEl.textContent = '00';
        if (minsEl) minsEl.textContent = '00';
        if (secsEl) secsEl.textContent = '00';
        if (adminTimerInterval) clearInterval(adminTimerInterval);
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
      if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');
    };

    updateAdminTimer();
    adminTimerInterval = setInterval(updateAdminTimer, 1000);
  }

  // Attach live preview listeners to inputs
  const eventNameInputEl = document.getElementById('event-name');
  const eventDateInputEl = document.getElementById('event-date');
  const eventTimeInputEl = document.getElementById('event-time');

  if (eventNameInputEl) {
    eventNameInputEl.addEventListener('input', updateTargetPreview);
  }
  if (eventDateInputEl) {
    eventDateInputEl.addEventListener('input', updateTargetPreview);
    eventDateInputEl.addEventListener('change', updateTargetPreview);
  }
  if (eventTimeInputEl) {
    eventTimeInputEl.addEventListener('input', updateTargetPreview);
    eventTimeInputEl.addEventListener('change', updateTargetPreview);
  }

  if (eventForm) {
    eventForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const eventError = document.getElementById('event-error');
      const eventSuccess = document.getElementById('event-success');
      if (eventError) eventError.hidden = true;
      if (eventSuccess) eventSuccess.hidden = true;

      const eventNameInput = document.getElementById('event-name') as HTMLInputElement;
      const eventDescInput = document.getElementById('event-desc') as HTMLInputElement;
      const eventDateInput = document.getElementById('event-date') as HTMLInputElement;
      const eventTimeInput = document.getElementById('event-time') as HTMLInputElement;

      const eventName = (eventNameInput?.value || '').trim();
      const eventDesc = (eventDescInput?.value || '').trim();
      const eventDate = (eventDateInput?.value || '').trim();
      const eventTime = (eventTimeInput?.value || '').trim();

      if (!eventName) {
        if (eventError) {
          eventError.textContent = 'EVENT NAME REQUIRED\n\nPlease enter an event name.';
          eventError.hidden = false;
        }
        return;
      }

      if (!eventDate) {
        if (eventError) {
          eventError.textContent = 'DATE REQUIRED\n\nPlease select an event date.';
          eventError.hidden = false;
        }
        return;
      }

      if (!eventTime) {
        if (eventError) {
          eventError.textContent = 'TIME REQUIRED\n\nPlease select an event time.';
          eventError.hidden = false;
        }
        return;
      }

      const targetDate = parseISTDateTime(eventDate, eventTime);
      if (!targetDate || targetDate.getTime() <= Date.now()) {
        if (eventError) {
          eventError.textContent = 'INVALID EVENT TIME\n\nPlease choose a future date and time.';
          eventError.hidden = false;
        }
        return;
      }

      try {
        const { data: userRes } = await supabase.auth.getUser();
        const userUid = userRes?.user?.id || null;

        const payload = {
          event_name: eventName,
          event_description: eventDesc || null,
          target_time: targetDate.toISOString(),
          is_active: true,
          updated_by: userUid
        };

        let resultError = null;
        if (activeEventClock?.id) {
          const { error } = await supabase
            .from('event_clock')
            .update({
              ...payload,
              updated_at: new Date().toISOString()
            })
            .eq('id', activeEventClock.id);
          resultError = error;
        } else {
          const { error } = await supabase
            .from('event_clock')
            .insert([payload]);
          resultError = error;
        }

        if (resultError) throw resultError;

        if (eventSuccess) {
          eventSuccess.hidden = false;
          setTimeout(() => {
            if (eventSuccess) eventSuccess.hidden = true;
          }, 2000);
        }

        await fetchEventClock();

      } catch (err: any) {
        console.error('Event clock save failed:', err);
        console.error('Event clock response:', { error: err });
        if (eventError) {
          eventError.textContent = 'UNABLE TO START COUNTDOWN\n\nPlease try again.';
          eventError.hidden = false;
        }
      }
    });
  }

  if (btnStopCountdown) {
    btnStopCountdown.addEventListener('click', async () => {
      if (!activeEventClock?.id) return;

      try {
        const { error } = await supabase
          .from('event_clock')
          .update({ is_active: false, updated_at: new Date().toISOString() })
          .eq('id', activeEventClock.id);

        if (error) throw error;

        await fetchEventClock();
      } catch (err) {
        console.error('Failed to stop countdown:', err);
      }
    });
  }

  // ── Fetch Registrations ───────────────────────────────────────────────────
  async function fetchRegistrations() {
    isLoading = true;
    loadError = false;
    showState('loading');

    try {
      const { data, error } = await supabase
        .from('registrations')
        .select(`
          id,
          team_name,
          leader_name,
          leader_email,
          leader_phone,
          leader_college,
          leader_year,
          member_2_name,
          member_2_email,
          member_2_phone,
          member_3_name,
          member_3_email,
          member_3_phone,
          member_4_name,
          member_4_email,
          member_4_phone,
          problem_domain,
          created_at
        `)
        .order('created_at', { ascending: false });

      if (error) {
        console.error('Failed to load registrations:', error);
        loadError = true;
        isLoading = false;
        registrations = [];
        showState('error');
        return;
      }

      registrations = (data || []) as Registration[];
      isLoading = false;
      loadError = false;

      updateStats(registrations);
      applyFiltersAndSort();

    } catch (err) {
      console.error('Failed to fetch registrations:', err);
      loadError = true;
      isLoading = false;
      registrations = [];
      showState('error');
    }
  }

  // ── UI States ─────────────────────────────────────────────────────────────
  const mobileCardsWrapper = document.getElementById('mobile-cards-wrapper');

  function showState(state: 'loading' | 'error' | 'empty' | 'table') {
    if (stateLoading) stateLoading.hidden = (state !== 'loading');
    if (stateError)   stateError.hidden   = (state !== 'error');
    if (stateEmpty)   stateEmpty.hidden   = (state !== 'empty');
    if (tableWrapper) tableWrapper.hidden = (state !== 'table');
    if (mobileCardsWrapper) mobileCardsWrapper.hidden = (state !== 'table');
  }

  // ── Summary Metrics Calculation ──────────────────────────────────────────
  function updateStats(regs: Registration[]) {
    const totalTeams = regs.length;

    let totalMembers = 0;
    const domainSet = new Set<string>();

    regs.forEach(r => {
      let count = 1; // Leader
      if (r.member_2_name && r.member_2_name.trim()) count++;
      if (r.member_3_name && r.member_3_name.trim()) count++;
      if (r.member_4_name && r.member_4_name.trim()) count++;
      totalMembers += count;

      if (r.problem_domain && r.problem_domain.trim()) {
        domainSet.add(r.problem_domain.trim());
      }
    });

    if (statTotalTeams) statTotalTeams.textContent = String(totalTeams);
    if (statTotalMembers) statTotalMembers.textContent = String(totalMembers);
    if (statDomains) statDomains.textContent = String(domainSet.size);
  }

  // ── Filtering & Sorting ────────────────────────────────────────────────────
  function applyFiltersAndSort() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const domain = domainFilter?.value || 'ALL';
    const sortBy = sortSelect?.value || 'LATEST';

    filteredRegistrations = registrations.filter(r => {
      if (domain !== 'ALL' && r.problem_domain !== domain) {
        return false;
      }

      if (query) {
        const teamMatch   = (r.team_name || '').toLowerCase().includes(query);
        const leaderMatch = (r.leader_name || '').toLowerCase().includes(query);
        const emailMatch  = (r.leader_email || '').toLowerCase().includes(query);
        const collegeMatch= (r.leader_college || '').toLowerCase().includes(query);
        if (!teamMatch && !leaderMatch && !emailMatch && !collegeMatch) {
          return false;
        }
      }

      return true;
    });

    filteredRegistrations.sort((a, b) => {
      if (sortBy === 'LATEST') {
        return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
      }
      if (sortBy === 'EARLIEST') {
        return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
      }
      if (sortBy === 'TEAM_NAME') {
        return (a.team_name || '').localeCompare(b.team_name || '');
      }
      if (sortBy === 'DOMAIN') {
        return (a.problem_domain || '').localeCompare(b.problem_domain || '');
      }
      return 0;
    });

    renderTableAndCards();
  }

  let lastFocusedElement: HTMLElement | null = null;

  // ── Render Table & Mobile Cards ──────────────────────────────────────────
  function renderTableAndCards() {
    if (!tbody) return;

    if (filteredRegistrations.length === 0) {
      if (tableWrapper) tableWrapper.hidden = true;
      if (mobileCardsWrapper) mobileCardsWrapper.hidden = true;
      if (stateEmpty) stateEmpty.hidden = false;
      return;
    }

    if (stateEmpty) stateEmpty.hidden = true;

    // Desktop view vs Mobile view
    const isMobile = window.innerWidth <= 768;
    if (isMobile) {
      if (tableWrapper) tableWrapper.hidden = true;
      if (mobileCardsWrapper) mobileCardsWrapper.hidden = false;
    } else {
      if (tableWrapper) tableWrapper.hidden = false;
      if (mobileCardsWrapper) mobileCardsWrapper.hidden = true;
    }

    tbody.innerHTML = filteredRegistrations.map((r, index) => {
      let memberCount = 1;
      if (r.member_2_name && r.member_2_name.trim()) memberCount++;
      if (r.member_3_name && r.member_3_name.trim()) memberCount++;
      if (r.member_4_name && r.member_4_name.trim()) memberCount++;

      const formattedDate = new Date(r.created_at).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });

      return `
        <tr data-id="${escapeHtml(r.id)}" tabindex="0" role="button" aria-label="View details for team ${escapeHtml(r.team_name)}">
          <td class="col-num mono">${index + 1}</td>
          <td class="col-team">${escapeHtml(r.team_name)}</td>
          <td class="col-domain">${escapeHtml(r.problem_domain)}</td>
          <td class="col-leader">
            <div class="leader-name">${escapeHtml(r.leader_name)}</div>
            <div class="leader-sub">${escapeHtml(r.leader_email)} &bull; ${escapeHtml(r.leader_phone)}</div>
          </td>
          <td class="col-college">${escapeHtml(r.leader_college)}</td>
          <td class="col-year mono">${escapeHtml(r.leader_year)}</td>
          <td class="col-members mono">
            <span class="member-pill">${memberCount} ${memberCount === 1 ? 'MEMBER' : 'MEMBERS'}</span>
          </td>
          <td class="col-date mono">${formattedDate}</td>
        </tr>
      `;
    }).join('');

    tbody.querySelectorAll('tr').forEach(row => {
      const handleTrigger = () => {
        const id = row.getAttribute('data-id');
        const reg = registrations.find(r => r.id === id);
        if (reg) openDetailModal(reg, row as HTMLElement);
      };
      row.addEventListener('click', handleTrigger);
      row.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleTrigger();
        }
      });
    });

    if (mobileCardsWrapper) {
      mobileCardsWrapper.innerHTML = filteredRegistrations.map(r => {
        let memberCount = 1;
        if (r.member_2_name && r.member_2_name.trim()) memberCount++;
        if (r.member_3_name && r.member_3_name.trim()) memberCount++;
        if (r.member_4_name && r.member_4_name.trim()) memberCount++;

        return `
          <div class="admin-mobile-card" data-id="${escapeHtml(r.id)}" tabindex="0" role="button" aria-label="View details for team ${escapeHtml(r.team_name)}">
            <div class="mobile-card-top">
              <span class="mobile-card-team">${escapeHtml(r.team_name)}</span>
              <span class="mobile-card-domain">${escapeHtml(r.problem_domain)}</span>
            </div>
            <div class="mobile-card-leader">
              <span class="mobile-card-leader-name">${escapeHtml(r.leader_name)}</span>
              <span class="mobile-card-leader-sub">${escapeHtml(r.leader_email)} &bull; ${escapeHtml(r.leader_phone)}</span>
            </div>
            <div class="mobile-card-bottom mono">
              <span>${escapeHtml(r.leader_college)} &bull; ${escapeHtml(r.leader_year)}</span>
              <span class="member-pill">${memberCount} ${memberCount === 1 ? 'MEMBER' : 'MEMBERS'}</span>
            </div>
          </div>
        `;
      }).join('');

      mobileCardsWrapper.querySelectorAll('.admin-mobile-card').forEach(card => {
        const handleTrigger = () => {
          const id = card.getAttribute('data-id');
          const reg = registrations.find(r => r.id === id);
          if (reg) openDetailModal(reg, card as HTMLElement);
        };
        card.addEventListener('click', handleTrigger);
        card.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handleTrigger();
          }
        });
      });
    }
  }

  // ── CSV Export Handler ──────────────────────────────────────────────────
  function exportRegistrationsToCsv() {
    if (!btnExportCsv) return;

    const exportList = registrations;

    if (!exportList || exportList.length === 0) {
      const originalText = btnExportCsv.innerHTML;
      btnExportCsv.innerHTML = 'NO REGISTRATIONS TO EXPORT';
      setTimeout(() => {
        btnExportCsv.innerHTML = originalText;
      }, 2500);
      return;
    }

    const headers = [
      'Registration ID',
      'Team Name',
      'Problem Domain',
      'Leader Name',
      'Leader Email',
      'Leader Phone',
      'College / Institution',
      'Year',
      'Member 2 Name',
      'Member 2 Email',
      'Member 2 Phone',
      'Member 3 Name',
      'Member 3 Email',
      'Member 3 Phone',
      'Member 4 Name',
      'Member 4 Email',
      'Member 4 Phone',
      'Registration Date'
    ];

    const rows = exportList.map(r => [
      escapeCsv(r.id),
      escapeCsv(r.team_name),
      escapeCsv(r.problem_domain),
      escapeCsv(r.leader_name),
      escapeCsv(r.leader_email),
      escapeCsv(r.leader_phone),
      escapeCsv(r.leader_college),
      escapeCsv(r.leader_year),
      escapeCsv(r.member_2_name),
      escapeCsv(r.member_2_email),
      escapeCsv(r.member_2_phone),
      escapeCsv(r.member_3_name),
      escapeCsv(r.member_3_email),
      escapeCsv(r.member_3_phone),
      escapeCsv(r.member_4_name),
      escapeCsv(r.member_4_email),
      escapeCsv(r.member_4_phone),
      escapeCsv(r.created_at)
    ].join(','));

    const csvContent = [headers.map(h => escapeCsv(h)).join(','), ...rows].join('\r\n');

    const dateStr = new Date().toISOString().split('T')[0];
    const filename = `zayathon-registrations-${dateStr}.csv`;

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', filename);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    const originalContent = btnExportCsv.innerHTML;
    btnExportCsv.innerHTML = 'EXPORTED ✓';
    setTimeout(() => {
      btnExportCsv.innerHTML = originalContent;
    }, 2000);
  }

  // ── Detail Modal (Redesigned Editorial Dossier View) ─────────────────────
  function openDetailModal(r: Registration, triggerEl?: HTMLElement) {
    if (!r || !detailModal || !modalTeamName || !modalBody) return;

    lastFocusedElement = triggerEl || (document.activeElement as HTMLElement);

    selectedRegistration = r;
    modalTeamName.textContent = selectedRegistration.team_name;

    let totalMembers = 1;
    if (selectedRegistration.member_2_name && selectedRegistration.member_2_name.trim()) totalMembers++;
    if (selectedRegistration.member_3_name && selectedRegistration.member_3_name.trim()) totalMembers++;
    if (selectedRegistration.member_4_name && selectedRegistration.member_4_name.trim()) totalMembers++;

    const membersText = `${totalMembers} ${totalMembers === 1 ? 'MEMBER' : 'MEMBERS'}`;

    const formattedDate = new Date(selectedRegistration.created_at).toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });

    const renderMemberCard = (label: string, name?: string | null, email?: string | null, phone?: string | null) => {
      if (!name || !name.trim()) return '';

      const emailHtml = email && email.trim() 
        ? `<a href="mailto:${escapeHtml(email)}" class="field-val link-contact">${escapeHtml(email)} <span class="contact-arrow">↗</span></a>`
        : `<span class="field-val muted">—</span>`;

      const phoneHtml = phone && phone.trim()
        ? `<a href="tel:${escapeHtml(phone)}" class="field-val link-contact">${escapeHtml(phone)} <span class="contact-arrow">↗</span></a>`
        : `<span class="field-val muted">—</span>`;

      return `
        <div class="member-card">
          <div class="member-card-subhead mono">${label}</div>
          <div class="dossier-grid">
            <div class="dossier-field full">
              <span class="field-lbl">FULL NAME</span>
              <span class="field-val highlight">${escapeHtml(name)}</span>
            </div>
            <div class="dossier-field">
              <span class="field-lbl">EMAIL</span>
              ${emailHtml}
            </div>
            <div class="dossier-field">
              <span class="field-lbl">PHONE</span>
              ${phoneHtml}
            </div>
          </div>
        </div>
      `;
    };

    let memberCardsHtml = '';
    memberCardsHtml += renderMemberCard('MEMBER 02', selectedRegistration.member_2_name, selectedRegistration.member_2_email, selectedRegistration.member_2_phone);
    memberCardsHtml += renderMemberCard('MEMBER 03', selectedRegistration.member_3_name, selectedRegistration.member_3_email, selectedRegistration.member_3_phone);
    memberCardsHtml += renderMemberCard('MEMBER 04', selectedRegistration.member_4_name, selectedRegistration.member_4_email, selectedRegistration.member_4_phone);

    const membersSectionContent = memberCardsHtml 
      ? `<div class="members-stack">${memberCardsHtml}</div>`
      : `<p class="empty-members-text mono">1 MEMBER &bull; LEADER ONLY</p>`;

    modalBody.innerHTML = `
      <div class="dossier-section identity-section">
        <div class="identity-grid">
          <div class="identity-block">
            <span class="field-lbl">PROBLEM DOMAIN</span>
            <span class="domain-val">${escapeHtml(selectedRegistration.problem_domain)}</span>
          </div>
          <div class="identity-block">
            <span class="field-lbl">REGISTRATION DATE</span>
            <span class="meta-val mono">${formattedDate}</span>
          </div>
          <div class="identity-block">
            <span class="field-lbl">TEAM SIZE</span>
            <span class="meta-val mono">${membersText}</span>
          </div>
        </div>
      </div>

      <div class="dossier-section">
        <div class="section-badge mono">01 / TEAM LEADER</div>
        <div class="dossier-grid">
          <div class="dossier-field">
            <span class="field-lbl">FULL NAME</span>
            <span class="field-val highlight">${escapeHtml(selectedRegistration.leader_name)}</span>
          </div>
          <div class="dossier-field">
            <span class="field-lbl">YEAR OF STUDY</span>
            <span class="field-val">${escapeHtml(selectedRegistration.leader_year)}</span>
          </div>
          <div class="dossier-field">
            <span class="field-lbl">EMAIL</span>
            <a href="mailto:${escapeHtml(selectedRegistration.leader_email)}" class="field-val link-contact">
              ${escapeHtml(selectedRegistration.leader_email)} <span class="contact-arrow">↗</span>
            </a>
          </div>
          <div class="dossier-field">
            <span class="field-lbl">PHONE</span>
            <a href="tel:${escapeHtml(selectedRegistration.leader_phone)}" class="field-val link-contact">
              ${escapeHtml(selectedRegistration.leader_phone)} <span class="contact-arrow">↗</span>
            </a>
          </div>
          <div class="dossier-field full">
            <span class="field-lbl">COLLEGE / INSTITUTION</span>
            <span class="field-val">${escapeHtml(selectedRegistration.leader_college)}</span>
          </div>
        </div>
      </div>

      <div class="dossier-section">
        <div class="section-badge mono">02 / TEAM MEMBERS</div>
        ${membersSectionContent}
      </div>
    `;

    detailModal.hidden = false;
    detailModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      if (btnCloseModal) btnCloseModal.focus();
    }, 50);
  }

  function closeDetailModal() {
    selectedRegistration = null;
    if (!detailModal) return;
    detailModal.hidden = true;
    detailModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // ── Event Listeners ────────────────────────────────────────────────────────
  if (searchInput) searchInput.addEventListener('input', applyFiltersAndSort);
  if (domainFilter) domainFilter.addEventListener('change', applyFiltersAndSort);
  if (sortSelect) sortSelect.addEventListener('change', applyFiltersAndSort);

  if (btnExportCsv) btnExportCsv.addEventListener('click', exportRegistrationsToCsv);
  if (btnRetry) btnRetry.addEventListener('click', fetchRegistrations);

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeDetailModal);
  if (modalBackdrop) modalBackdrop.addEventListener('click', closeDetailModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && detailModal && !detailModal.hidden) {
      closeDetailModal();
    }
  });

  if (btnSignOut) {
    btnSignOut.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/admin/login';
    });
  }

  // Run initialization
  initAdminDashboard();
</script>
