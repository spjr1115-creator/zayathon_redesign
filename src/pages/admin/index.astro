---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="admin-dashboard-page">
    
    <!-- Top Header -->
    <header class="admin-header">
      <div class="header-inner container-wide">
        <div class="brand-group">
          <span class="brand-name">ZAYATHON</span>
          <span class="brand-divider">/</span>
          <span class="brand-sub mono">REGISTRATION CONTROL</span>
        </div>
        <div class="user-group">
          <span class="admin-badge mono">ADMIN</span>
          <button type="button" id="btn-signout" class="signout-link">
            SIGN OUT <span class="arrow">↗</span>
          </button>
        </div>
      </div>
    </header>

    <div class="container dashboard-container">
      
      <!-- Page Title Section -->
      <div class="dash-title-section">
        <div class="title-header-row">
          <div>
            <h1 class="dash-title">REGISTRATIONS</h1>
            <p class="dash-subtitle">Manage and review submitted ZAYATHON 2026 teams.</p>
          </div>
          <button type="button" id="btn-export-csv" class="btn-export mono" aria-label="Export registrations to CSV">
            EXPORT CSV <span class="arrow">↗</span>
          </button>
        </div>
      </div>

      <!-- Stats Summary Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-label mono">TOTAL TEAMS</span>
          <span class="stat-value" id="stat-total-teams">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label mono">TOTAL MEMBERS</span>
          <span class="stat-value" id="stat-total-members">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label mono">DOMAINS</span>
          <span class="stat-value" id="stat-domains">—</span>
        </div>
      </div>

      <!-- Admin Event Control Section -->
      <section class="event-control-card">
        <div class="event-control-header">
          <div class="event-control-title-group">
            <span class="section-label mono">04 / EVENT CONTROL</span>
            <h2 class="event-control-heading font-display">NEXT EVENT &bull; CONTROL THE CLOCK</h2>
            <p class="event-control-subtitle">Set the next public event and decide exactly when it goes live.</p>
          </div>
          <div id="event-state-badge" class="state-badge mono inactive">○ COUNTDOWN INACTIVE</div>
        </div>

        <!-- Active Event Live Countdown Preview Panel -->
        <div id="active-event-display" class="active-event-box" hidden>
          <div class="active-event-info">
            <span class="field-lbl mono">COUNTDOWN ACTIVE</span>
            <div id="active-event-name" class="active-title font-display">—</div>
            <p id="active-event-desc-display" class="active-desc" hidden></p>
            <div id="active-event-target" class="active-meta mono">—</div>
          </div>
          
          <div class="active-event-timer mono">
            <div class="admin-timer-unit">
              <span id="admin-cd-days" class="admin-unit-val">00</span>
              <span class="admin-unit-lbl">DAYS</span>
            </div>
            <span class="admin-timer-sep">:</span>
            <div class="admin-timer-unit">
              <span id="admin-cd-hours" class="admin-unit-val">00</span>
              <span class="admin-unit-lbl">HOURS</span>
            </div>
            <span class="admin-timer-sep">:</span>
            <div class="admin-timer-unit">
              <span id="admin-cd-minutes" class="admin-unit-val">00</span>
              <span class="admin-unit-lbl">MINUTES</span>
            </div>
            <span class="admin-timer-sep">:</span>
            <div class="admin-timer-unit">
              <span id="admin-cd-seconds" class="admin-unit-val">00</span>
              <span class="admin-unit-lbl">SECONDS</span>
            </div>
          </div>

          <button type="button" id="btn-stop-countdown" class="btn-stop-countdown mono">
            STOP COUNTDOWN
          </button>
        </div>

        <!-- Event Form -->
        <form id="event-control-form" class="event-form" novalidate>
          <div id="event-error" class="event-error" aria-live="assertive" hidden></div>
          <div id="event-success" class="event-success mono" aria-live="polite" hidden>COUNTDOWN STARTED ✓</div>

          <div class="event-form-grid">
            <div class="field-group full">
              <label for="event-name" class="field-lbl">EVENT NAME <span class="req">*</span></label>
              <input 
                type="text" 
                id="event-name" 
                name="event_name" 
                class="admin-input"
                placeholder="e.g. REGISTRATION OPENS" 
                required 
              />
            </div>

            <div class="field-group full">
              <label for="event-desc" class="field-lbl">DESCRIPTION</label>
              <input 
                type="text" 
                id="event-desc" 
                name="event_description" 
                class="admin-input"
                placeholder="e.g. Secure your team's place at ZAYATHON." 
              />
            </div>

            <div class="field-group">
              <label for="event-date" class="field-lbl">DATE <span class="req">*</span></label>
              <input 
                type="date" 
                id="event-date" 
                name="event_date" 
                class="admin-input date-input"
                required 
              />
              <span class="field-hint mono">IST / ASIA-KOLKATA</span>
            </div>

            <div class="field-group">
              <label for="event-time" class="field-lbl">TIME <span class="req">*</span></label>
              <input 
                type="time" 
                id="event-time" 
                name="event_time" 
                class="admin-input time-input"
                required 
              />
              <span class="field-hint mono">IST</span>
            </div>
          </div>

          <!-- Live Target Preview Box -->
          <div id="target-preview-box" class="target-preview-box">
            <span class="field-lbl mono">TARGET EVENT PREVIEW</span>
            <div id="preview-event-name" class="preview-name font-display">—</div>
            <div id="preview-target-time" class="preview-time mono">SELECT DATE & TIME TO PREVIEW TARGET</div>
          </div>

          <button type="submit" id="btn-start-countdown" class="btn-submit-event font-display">
            START COUNTDOWN <span class="arrow">↗</span>
          </button>
        </form>
      </section>

      <!-- Controls & Filter Bar -->
      <div class="controls-bar">
        
        <!-- Search -->
        <div class="search-wrapper">
          <svg class="search-icon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="9" cy="9" r="6" />
            <path d="M13.5 13.5L17 17" />
          </svg>
          <input 
            type="text" 
            id="search-input" 
            class="search-input" 
            placeholder="SEARCH REGISTRATIONS (Team, Leader, Email, College)..." 
            aria-label="Search registrations"
          />
        </div>

        <!-- Domain Filter -->
        <div class="filter-group">
          <label for="domain-filter" class="sr-only">Filter by Domain</label>
          <div class="select-wrapper">
            <select id="domain-filter" class="filter-select">
              <option value="ALL">ALL DOMAINS</option>
              <option value="Agentic AI">Agentic AI</option>
              <option value="Robotics & Autonomous Systems">Robotics & Autonomous Systems</option>
              <option value="Cybersecurity & Threat Intelligence">Cybersecurity & Threat Intelligence</option>
              <option value="HealthTech & MedAI">HealthTech & MedAI</option>
              <option value="FinTech & Blockchain">FinTech & Blockchain</option>
              <option value="Smart Cities & IoT">Smart Cities & IoT</option>
              <option value="Agritech & Rural Innovation">Agritech & Rural Innovation</option>
              <option value="Transportation & Logistics">Transportation & Logistics</option>
              <option value="Open Innovation">Open Innovation</option>
            </select>
            <svg class="select-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
          </div>
        </div>

        <!-- Sort -->
        <div class="filter-group">
          <label for="sort-select" class="sr-only">Sort Registrations</label>
          <div class="select-wrapper">
            <select id="sort-select" class="filter-select">
              <option value="LATEST">SORT: LATEST</option>
              <option value="EARLIEST">SORT: EARLIEST</option>
              <option value="TEAM_NAME">SORT: TEAM NAME</option>
              <option value="DOMAIN">SORT: DOMAIN</option>
            </select>
            <svg class="select-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
          </div>
        </div>

      </div>

      <!-- Main Content Area: Loading / Error / Empty / Table -->
      <div id="dashboard-content" class="dashboard-content">
        
        <!-- Loading State -->
        <div id="state-loading" class="state-view">
          <div class="loading-spinner" aria-hidden="true"></div>
          <p class="state-title mono">LOADING REGISTRATIONS...</p>
        </div>

        <!-- Error State -->
        <div id="state-error" class="state-view" hidden>
          <p class="state-title font-display">UNABLE TO LOAD REGISTRATIONS</p>
          <p class="state-desc">Please try again.</p>
          <button type="button" id="btn-retry" class="btn-retry mono">
            RETRY <span class="arrow">↗</span>
          </button>
        </div>

        <!-- Empty State -->
        <div id="state-empty" class="state-view" hidden>
          <p class="state-title font-display">NO REGISTRATIONS YET</p>
          <p class="state-desc">Teams will appear here once registration begins.</p>
        </div>

        <!-- Data Table Container (Desktop) -->
        <div id="table-wrapper" class="table-wrapper" hidden>
          <table class="registrations-table" aria-label="ZAYATHON Registrations">
            <thead>
              <tr>
                <th class="col-num mono">#</th>
                <th class="col-team">TEAM</th>
                <th class="col-domain">DOMAIN</th>
                <th class="col-leader">LEADER</th>
                <th class="col-college">COLLEGE</th>
                <th class="col-year mono">YEAR</th>
                <th class="col-members mono">MEMBERS</th>
                <th class="col-date mono">REGISTERED</th>
              </tr>
            </thead>
            <tbody id="registrations-tbody">
              <!-- Rows rendered dynamically via JS -->
            </tbody>
          </table>
        </div>

        <!-- Mobile Cards Container (Mobile <= 768px) -->
        <div id="mobile-cards-wrapper" class="mobile-cards-wrapper" hidden>
          <!-- Cards rendered dynamically via JS -->
        </div>

      </div>

    </div>

    <!-- Registration Detail Slide-over / Modal Panel -->
    <div id="detail-modal" class="detail-modal" hidden aria-hidden="true">
      <div class="modal-backdrop" id="modal-backdrop"></div>
      <div class="modal-panel" role="dialog" aria-labelledby="modal-team-name" aria-modal="true">
        
        <header class="modal-header">
          <div class="modal-header-title-group">
            <span class="modal-label mono">TEAM DETAILS &bull; REGISTRATION PROFILE</span>
            <h2 id="modal-team-name" class="modal-title">—</h2>
          </div>
          <button type="button" id="btn-close-modal" class="btn-close-modal" aria-label="Close detail panel">
            ✕ CLOSE
          </button>
        </header>

        <div class="modal-body" id="modal-body">
          <!-- Dynamically populated detail sections -->
        </div>

      </div>
    </div>

  </main>
</BaseLayout>

<style>
  [hidden] {
    display: none !important;
  }

  .admin-dashboard-page {
    background-color: #F0F0EE;
    color: #111111;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans, 'Inter', sans-serif);
    padding-bottom: 80px;
  }

  .admin-header {
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding: 20px 0;
    background: #F0F0EE;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-name {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-divider {
    color: #999999;
  }

  .brand-sub {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: #777777;
  }

  .user-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .admin-badge {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #777777;
    background: rgba(17, 17, 17, 0.06);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .signout-link {
    background: none;
    border: none;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: #777777;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 250ms ease;
  }

  .signout-link:hover {
    color: var(--blue, #1d4ed8);
  }

  .dashboard-container {
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .dash-title-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn-export {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 8px;
    height: 48px;
    padding: 0 20px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #111111;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
    white-space: nowrap;
  }

  .btn-export:hover:not(:disabled) {
    background: #111111;
    color: #FFFFFF;
    border-color: #111111;
  }

  .btn-export:focus-visible {
    outline: none;
    border-color: var(--blue, #1d4ed8);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
  }

  .btn-export:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .dash-title {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #111111;
  }

  .dash-subtitle {
    font-size: 1.1rem;
    color: #555555;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }

  .stat-card {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: #777777;
  }

  .stat-value {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #111111;
  }

  /* Event Control Card */
  .event-control-card {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .event-control-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
  }

  .event-control-title-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: #777777;
    text-transform: uppercase;
  }

  .event-control-heading {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #111111;
    text-transform: uppercase;
  }

  .event-control-subtitle {
    font-size: 0.92rem;
    color: #555555;
  }

  .state-badge {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    padding: 6px 14px;
    border-radius: 6px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .state-badge.inactive {
    background: rgba(17, 17, 17, 0.06);
    color: #777777;
  }

  .state-badge.active {
    background: rgba(29, 78, 216, 0.08);
    color: var(--blue, #1d4ed8);
    border: 1px solid rgba(29, 78, 216, 0.2);
  }

  .active-event-box {
    background: #FAFAFA;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 10px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .active-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #111111;
    margin-top: 4px;
    letter-spacing: -0.02em;
  }

  .active-desc {
    font-size: 0.95rem;
    color: #555555;
    margin-top: 4px;
  }

  .active-meta {
    font-size: 0.82rem;
    color: #777777;
    margin-top: 6px;
  }

  .active-event-timer {
    display: flex;
    align-items: center;
    gap: 20px;
    background: #111111;
    color: #FFFFFF;
    padding: 20px 28px;
    border-radius: 10px;
    width: fit-content;
  }

  .admin-timer-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .admin-unit-val {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1;
  }

  .admin-unit-lbl {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: #999999;
    margin-top: 6px;
  }

  .admin-timer-sep {
    font-size: 1.4rem;
    color: #555555;
  }

  .btn-stop-countdown {
    align-self: flex-start;
    background: #FFFFFF;
    color: #dc2626;
    border: 1px solid rgba(220, 38, 38, 0.3);
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .btn-stop-countdown:hover {
    background: rgba(220, 38, 38, 0.06);
    border-color: #dc2626;
  }

  .event-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .event-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-group.full {
    grid-column: 1 / -1;
  }

  .admin-input {
    width: 100%;
    height: 48px;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.18);
    border-radius: 8px;
    padding: 0 16px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.95rem;
    color: #111111;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .admin-input:focus {
    outline: none;
    border-color: var(--blue, #1d4ed8);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
  }

  .date-input, .time-input {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .req {
    color: var(--blue, #1d4ed8);
  }

  .field-hint {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #777777;
    margin-top: 2px;
  }

  .target-preview-box {
    background: #F9F9F8;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 8px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .preview-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: #111111;
  }

  .preview-time {
    font-size: 0.85rem;
    color: var(--blue, #1d4ed8);
  }

  .event-error {
    background: rgba(220, 38, 38, 0.06);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: 8px;
    padding: 14px 16px;
    color: #dc2626;
    font-size: 0.88rem;
    white-space: pre-line;
  }

  .event-success {
    background: rgba(29, 78, 216, 0.08);
    border: 1px solid rgba(29, 78, 216, 0.2);
    border-radius: 8px;
    padding: 14px 16px;
    color: var(--blue, #1d4ed8);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .btn-submit-event {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #111111;
    color: #FFFFFF;
    border: none;
    height: 50px;
    padding: 0 28px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 200ms ease;
  }

  .btn-submit-event:hover {
    background: #333333;
  }

  /* Controls Bar */
  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .search-wrapper {
    flex: 1 1 300px;
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #777777;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 48px;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 8px;
    padding: 0 16px 0 44px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.85rem;
    color: #111111;
    transition: border-color 250ms ease, box-shadow 250ms ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--blue, #1d4ed8);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
  }

  .filter-group {
    flex: 0 0 200px;
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .filter-select {
    width: 100%;
    height: 48px;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 8px;
    padding: 0 36px 0 14px;
