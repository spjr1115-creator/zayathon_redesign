---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="admin-dashboard-page">
    
    <!-- Top Header -->
    <header class="admin-header">
      <div class="header-inner container-wide">
        <div class="brand-group">
          <span class="brand-name">ZAYATHON</span>
          <span class="brand-divider">/</span>
          <span class="brand-sub mono">REGISTRATION CONTROL</span>
        </div>
        <div class="user-group">
          <span class="admin-badge mono">ADMIN</span>
          <button type="button" id="btn-signout" class="signout-link">
            SIGN OUT <span class="arrow">↗</span>
          </button>
        </div>
      </div>
    </header>

    <div class="container dashboard-container">
      
      <!-- Page Title Section -->
      <div class="dash-title-section">
        <h1 class="dash-title">REGISTRATIONS</h1>
        <p class="dash-subtitle">Manage and review submitted ZAYATHON 2026 teams.</p>
      </div>

      <!-- Stats Summary Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-label mono">TOTAL TEAMS</span>
          <span class="stat-value" id="stat-total-teams">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label mono">TOTAL MEMBERS</span>
          <span class="stat-value" id="stat-total-members">—</span>
        </div>
        <div class="stat-card">
          <span class="stat-label mono">DOMAINS</span>
          <span class="stat-value" id="stat-domains">—</span>
        </div>
      </div>

      <!-- Controls & Filter Bar -->
      <div class="controls-bar">
        
        <!-- Search -->
        <div class="search-wrapper">
          <svg class="search-icon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="9" cy="9" r="6" />
            <path d="M13.5 13.5L17 17" />
          </svg>
          <input 
            type="text" 
            id="search-input" 
            class="search-input" 
            placeholder="SEARCH REGISTRATIONS (Team, Leader, Email, College)..." 
            aria-label="Search registrations"
          />
        </div>

        <!-- Domain Filter -->
        <div class="filter-group">
          <label for="domain-filter" class="sr-only">Filter by Domain</label>
          <div class="select-wrapper">
            <select id="domain-filter" class="filter-select">
              <option value="ALL">ALL DOMAINS</option>
              <option value="Agentic AI">Agentic AI</option>
              <option value="Robotics & Autonomous Systems">Robotics & Autonomous Systems</option>
              <option value="Cybersecurity & Threat Intelligence">Cybersecurity & Threat Intelligence</option>
              <option value="HealthTech & MedAI">HealthTech & MedAI</option>
              <option value="FinTech & Blockchain">FinTech & Blockchain</option>
              <option value="Smart Cities & IoT">Smart Cities & IoT</option>
              <option value="Agritech & Rural Innovation">Agritech & Rural Innovation</option>
              <option value="Transportation & Logistics">Transportation & Logistics</option>
              <option value="Open Innovation">Open Innovation</option>
            </select>
            <svg class="select-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
          </div>
        </div>

        <!-- Sort -->
        <div class="filter-group">
          <label for="sort-select" class="sr-only">Sort Registrations</label>
          <div class="select-wrapper">
            <select id="sort-select" class="filter-select">
              <option value="LATEST">SORT: LATEST</option>
              <option value="EARLIEST">SORT: EARLIEST</option>
              <option value="TEAM_NAME">SORT: TEAM NAME</option>
              <option value="DOMAIN">SORT: DOMAIN</option>
            </select>
            <svg class="select-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
          </div>
        </div>

      </div>

      <!-- Main Content Area: Loading / Error / Empty / Table -->
      <div id="dashboard-content" class="dashboard-content">
        
        <!-- Loading State -->
        <div id="state-loading" class="state-view">
          <div class="loading-spinner" aria-hidden="true"></div>
          <p class="state-title mono">LOADING REGISTRATIONS...</p>
        </div>

        <!-- Error State -->
        <div id="state-error" class="state-view" hidden>
          <p class="state-title font-display">UNABLE TO LOAD REGISTRATIONS</p>
          <p class="state-desc">Please try again.</p>
          <button type="button" id="btn-retry" class="btn-retry mono">
            RETRY <span class="arrow">↗</span>
          </button>
        </div>

        <!-- Empty State -->
        <div id="state-empty" class="state-view" hidden>
          <p class="state-title font-display">NO REGISTRATIONS YET</p>
          <p class="state-desc">Teams will appear here once registration begins.</p>
        </div>

        <!-- Data Table Container -->
        <div id="table-wrapper" class="table-wrapper" hidden>
          <table class="registrations-table" aria-label="ZAYATHON Registrations">
            <thead>
              <tr>
                <th class="col-num mono">#</th>
                <th class="col-team">TEAM</th>
                <th class="col-domain">DOMAIN</th>
                <th class="col-leader">LEADER</th>
                <th class="col-college">COLLEGE</th>
                <th class="col-year mono">YEAR</th>
                <th class="col-members mono">MEMBERS</th>
                <th class="col-date mono">REGISTERED</th>
              </tr>
            </thead>
            <tbody id="registrations-tbody">
              <!-- Rows rendered dynamically via JS -->
            </tbody>
          </table>
        </div>

      </div>

    </div>

    <!-- Registration Detail Slide-over / Modal Panel -->
    <div id="detail-modal" class="detail-modal" hidden aria-hidden="true">
      <div class="modal-backdrop" id="modal-backdrop"></div>
      <div class="modal-panel" role="dialog" aria-labelledby="modal-team-name" aria-modal="true">
        
        <header class="modal-header">
          <div class="modal-header-title-group">
            <span class="modal-label mono">TEAM DETAILS &bull; REGISTRATION PROFILE</span>
            <h2 id="modal-team-name" class="modal-title">—</h2>
          </div>
          <button type="button" id="btn-close-modal" class="btn-close-modal" aria-label="Close detail panel">
            ✕ CLOSE
          </button>
        </header>

        <div class="modal-body" id="modal-body">
          <!-- Dynamically populated detail sections -->
        </div>

      </div>
    </div>

  </main>
</BaseLayout>

<style>
  [hidden] {
    display: none !important;
  }

  .admin-dashboard-page {
    background-color: #F0F0EE;
    color: #111111;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans, 'Inter', sans-serif);
    padding-bottom: 80px;
  }

  .admin-header {
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding: 20px 0;
    background: #F0F0EE;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-name {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-divider {
    color: #999999;
  }

  .brand-sub {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: #777777;
  }

  .user-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .admin-badge {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #777777;
    background: rgba(17, 17, 17, 0.06);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .signout-link {
    background: none;
    border: none;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: #777777;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 250ms ease;
  }

  .signout-link:hover {
    color: var(--blue, #1d4ed8);
  }

  .dashboard-container {
    padding-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .dash-title-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dash-title {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #111111;
  }

  .dash-subtitle {
    font-size: 1.1rem;
    color: #555555;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }

  .stat-card {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: #777777;
  }

  .stat-value {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: #111111;
  }

  /* Controls Bar */
  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .search-wrapper {
    flex: 1 1 300px;
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #777777;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 48px;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 8px;
    padding: 0 16px 0 44px;
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.85rem;
    color: #111111;
    transition: border-color 250ms ease, box-shadow 250ms ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--blue, #1d4ed8);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
  }

  .filter-group {
    flex: 0 0 200px;
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .filter-select {
    width: 100%;
    height: 48px;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 8px;
    padding: 0 36px 0 14px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #111111;
    appearance: none;
    cursor: pointer;
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--blue, #1d4ed8);
  }

  .select-arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #777777;
    pointer-events: none;
  }

  /* Content Views */
  .dashboard-content {
    min-height: 350px;
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 12px;
    overflow: hidden;
  }

  .state-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    text-align: center;
    gap: 16px;
  }

  .loading-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid rgba(17, 17, 17, 0.1);
    border-top-color: var(--blue, #1d4ed8);
    border-radius: 50%;
    animation: spin 800ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .state-title {
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: #111111;
  }

  .state-desc {
    font-size: 0.95rem;
    color: #777777;
  }

  .btn-retry {
    background: #111111;
    color: #FFFFFF;
    border: none;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 250ms ease;
  }

  .btn-retry:hover {
    background: #333333;
  }

  /* Table */
  .table-wrapper {
    width: 100%;
    overflow-x: auto;
  }

  .registrations-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    white-space: nowrap;
  }

  .registrations-table th {
    background: #FAFAFA;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: #777777;
    text-transform: uppercase;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.1);
  }

  .registrations-table td {
    padding: 18px 20px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.06);
    font-size: 0.9rem;
    color: #111111;
  }

  .registrations-table tbody tr {
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .registrations-table tbody tr:hover {
    background-color: rgba(29, 78, 216, 0.03);
  }

  .col-team {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-weight: 600;
    font-size: 1rem !important;
  }

  .leader-name {
    font-weight: 500;
  }
  
  .leader-sub {
    font-size: 0.78rem;
    color: #777777;
    margin-top: 2px;
  }

  .member-pill {
    display: inline-block;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    background: rgba(17, 17, 17, 0.05);
    border-radius: 4px;
    color: #333333;
  }

  .col-date {
    color: #777777 !important;
    font-size: 0.8rem !important;
  }

  /* Detail Modal / Panel Dossier Styling */
  .detail-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 17, 17, 0.45);
    backdrop-filter: blur(4px);
    transition: opacity 250ms ease;
  }

  .modal-panel {
    position: relative;
    z-index: 101;
    width: 100%;
    max-width: 560px;
    height: 100%;
    background: #F0F0EE;
    display: flex;
    flex-direction: column;
    box-shadow: -12px 0 40px rgba(0, 0, 0, 0.15);
    animation: slideLeft 300ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideLeft {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .modal-header {
    padding: 28px 32px;
    background: #F0F0EE;
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .modal-header-title-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .modal-label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: #777777;
    text-transform: uppercase;
  }

  .modal-title {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #111111;
    text-transform: uppercase;
    line-height: 1.05;
    word-break: break-word;
  }

  .btn-close-modal {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 6px;
    padding: 8px 14px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: #111111;
    cursor: pointer;
    transition: background 200ms, border-color 200ms, color 200ms;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .btn-close-modal:hover {
    background: #111111;
    color: #FFFFFF;
    border-color: #111111;
  }

  .modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Dossier Sections */
  .dossier-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
  }

  .dossier-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .identity-section {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 12px;
    padding: 20px 24px;
    gap: 0;
  }

  .identity-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 20px 16px;
  }

  .identity-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .domain-val {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--blue, #1d4ed8);
    line-height: 1.3;
  }

  .meta-val {
    font-size: 0.85rem;
    font-weight: 500;
    color: #111111;
  }

  .section-badge {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: #777777;
    text-transform: uppercase;
    font-weight: 600;
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
  }

  .dossier-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    user-select: text;
  }

  .dossier-field.full {
    grid-column: 1 / -1;
  }

  .field-lbl {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.63rem;
    letter-spacing: 0.12em;
    color: #777777;
    text-transform: uppercase;
  }

  .field-val {
    font-size: 0.95rem;
    font-weight: 400;
    color: #111111;
    line-height: 1.4;
    word-break: break-word;
  }

  .field-val.highlight {
    font-family: var(--font-display, 'Inter Tight', sans-serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .field-val.muted {
    color: #999999;
  }

  /* Interactive Contact Links */
  .link-contact {
    color: #111111;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 200ms ease;
  }

  .link-contact:hover {
    color: var(--blue, #1d4ed8);
    text-decoration: underline;
  }

  .contact-arrow {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8em;
    color: #777777;
    transition: transform 200ms ease, color 200ms ease;
  }

  .link-contact:hover .contact-arrow {
    transform: translate(2px, -2px);
    color: var(--blue, #1d4ed8);
  }

  /* Member Cards Stack */
  .members-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .member-card {
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .member-card-subhead {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: #777777;
    text-transform: uppercase;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(17, 17, 17, 0.1);
  }

  .empty-members-text {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: #777777;
    background: rgba(17, 17, 17, 0.04);
    padding: 12px 16px;
    border-radius: 6px;
  }

  /* Mobile Tweaks */
  @media (max-width: 768px) {
    .modal-panel {
      max-width: 100%;
    }
    .modal-header {
      padding: 20px 24px;
    }
    .modal-body {
      padding: 24px;
    }
    .dossier-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-panel {
      animation: none !important;
    }
    .contact-arrow {
      transition: none !important;
    }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;

  if (!supabaseUrl || !supabaseKey) {
    throw new Error(
      'Missing Supabase configuration. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_KEY.'
    );
  }

  const supabase = createClient(supabaseUrl, supabaseKey);

  // HTML Escape Helper
  function escapeHtml(str: string | null | undefined): string {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[char]!));
  }

  interface Registration {
    id: string;
    team_name: string;
    problem_domain: string;
    leader_name: string;
    leader_email: string;
    leader_phone: string;
    leader_college: string;
    leader_year: string;
    member_2_name?: string | null;
    member_2_email?: string | null;
    member_2_phone?: string | null;
    member_3_name?: string | null;
    member_3_email?: string | null;
    member_3_phone?: string | null;
    member_4_name?: string | null;
    member_4_email?: string | null;
    member_4_phone?: string | null;
    created_at: string;
  }

  // State Variables
  let isLoading = true;
  let loadError = false;
  let registrations: Registration[] = [];
  let filteredRegistrations: Registration[] = [];
  let selectedRegistration: Registration | null = null;

  // DOM Elements
  const btnSignOut = document.getElementById('btn-signout');
  const statTotalTeams = document.getElementById('stat-total-teams');
  const statTotalMembers = document.getElementById('stat-total-members');
  const statDomains = document.getElementById('stat-domains');

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const domainFilter = document.getElementById('domain-filter') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;

  const stateLoading = document.getElementById('state-loading');
  const stateError = document.getElementById('state-error');
  const stateEmpty = document.getElementById('state-empty');
  const tableWrapper = document.getElementById('table-wrapper');
  const tbody = document.getElementById('registrations-tbody');

  const btnRetry = document.getElementById('btn-retry');

  const detailModal = document.getElementById('detail-modal');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const btnCloseModal = document.getElementById('btn-close-modal');
  const modalTeamName = document.getElementById('modal-team-name');
  const modalBody = document.getElementById('modal-body');

  // ── Session & Authorization Check ─────────────────────────────────────────
  async function initAdminDashboard() {
    closeDetailModal(); // Ensure detail modal is closed initially

    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) {
      window.location.href = '/admin/login';
      return;
    }

    const isAuthorized = await verifyAdmin(session.user.id, session.user.email);
    if (!isAuthorized) {
      await supabase.auth.signOut();
      window.location.href = '/admin/login';
      return;
    }

    // Load registrations only after authorized
    await fetchRegistrations();
  }

  async function verifyAdmin(userId: string, email?: string): Promise<boolean> {
    try {
      const { data, error } = await supabase
        .from('admin_users')
        .select('*');

      if (error || !data || data.length === 0) {
        return false;
      }

      return data.some((row: any) => 
        row.user_id === userId || 
        (email && row.email === email) || 
        row.id === userId
      );
    } catch {
      return false;
    }
  }

  // ── Fetch Registrations ───────────────────────────────────────────────────
  async function fetchRegistrations() {
    isLoading = true;
    loadError = false;
    showState('loading');

    try {
      const { data, error } = await supabase
        .from('registrations')
        .select(`
          id,
          team_name,
          leader_name,
          leader_email,
          leader_phone,
          leader_college,
          leader_year,
          member_2_name,
          member_2_email,
          member_2_phone,
          member_3_name,
          member_3_email,
          member_3_phone,
          member_4_name,
          member_4_email,
          member_4_phone,
          problem_domain,
          created_at
        `)
        .order('created_at', { ascending: false });

      if (error) {
        console.error('Failed to load registrations:', error);
        loadError = true;
        isLoading = false;
        registrations = [];
        showState('error');
        return;
      }

      registrations = (data || []) as Registration[];
      isLoading = false;
      loadError = false;

      updateStats(registrations);
      applyFiltersAndSort();

    } catch (err) {
      console.error('Failed to fetch registrations:', err);
      loadError = true;
      isLoading = false;
      registrations = [];
      showState('error');
    }
  }

  // ── UI States ─────────────────────────────────────────────────────────────
  function showState(state: 'loading' | 'error' | 'empty' | 'table') {
    if (stateLoading) stateLoading.hidden = (state !== 'loading');
    if (stateError)   stateError.hidden   = (state !== 'error');
    if (stateEmpty)   stateEmpty.hidden   = (state !== 'empty');
    if (tableWrapper) tableWrapper.hidden = (state !== 'table');
  }

  // ── Summary Metrics Calculation ──────────────────────────────────────────
  function updateStats(regs: Registration[]) {
    const totalTeams = regs.length;

    let totalMembers = 0;
    const domainSet = new Set<string>();

    regs.forEach(r => {
      let count = 1; // Leader
      if (r.member_2_name && r.member_2_name.trim()) count++;
      if (r.member_3_name && r.member_3_name.trim()) count++;
      if (r.member_4_name && r.member_4_name.trim()) count++;
      totalMembers += count;

      if (r.problem_domain && r.problem_domain.trim()) {
        domainSet.add(r.problem_domain.trim());
      }
    });

    if (statTotalTeams) statTotalTeams.textContent = String(totalTeams);
    if (statTotalMembers) statTotalMembers.textContent = String(totalMembers);
    if (statDomains) statDomains.textContent = String(domainSet.size);
  }

  // ── Filtering & Sorting ────────────────────────────────────────────────────
  function applyFiltersAndSort() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const domain = domainFilter?.value || 'ALL';
    const sortBy = sortSelect?.value || 'LATEST';

    filteredRegistrations = registrations.filter(r => {
      // Domain filter
      if (domain !== 'ALL' && r.problem_domain !== domain) {
        return false;
      }

      // Search query filter
      if (query) {
        const teamMatch   = (r.team_name || '').toLowerCase().includes(query);
        const leaderMatch = (r.leader_name || '').toLowerCase().includes(query);
        const emailMatch  = (r.leader_email || '').toLowerCase().includes(query);
        const collegeMatch= (r.leader_college || '').toLowerCase().includes(query);
        if (!teamMatch && !leaderMatch && !emailMatch && !collegeMatch) {
          return false;
        }
      }

      return true;
    });

    // Sorting
    filteredRegistrations.sort((a, b) => {
      if (sortBy === 'LATEST') {
        return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
      }
      if (sortBy === 'EARLIEST') {
        return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
      }
      if (sortBy === 'TEAM_NAME') {
        return (a.team_name || '').localeCompare(b.team_name || '');
      }
      if (sortBy === 'DOMAIN') {
        return (a.problem_domain || '').localeCompare(b.problem_domain || '');
      }
      return 0;
    });

    renderTable();
  }

  // ── Render Table ──────────────────────────────────────────────────────────
  function renderTable() {
    if (isLoading) {
      showState('loading');
      return;
    }

    if (loadError) {
      showState('error');
      return;
    }

    if (filteredRegistrations.length === 0) {
      showState('empty');
      return;
    }

    showState('table');
    if (!tbody) return;

    tbody.innerHTML = filteredRegistrations.map((r, index) => {
      let memberCount = 1;
      if (r.member_2_name && r.member_2_name.trim()) memberCount++;
      if (r.member_3_name && r.member_3_name.trim()) memberCount++;
      if (r.member_4_name && r.member_4_name.trim()) memberCount++;

      const formattedDate = new Date(r.created_at).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });

      return `
        <tr data-id="${escapeHtml(r.id)}">
          <td class="col-num mono">${index + 1}</td>
          <td class="col-team">${escapeHtml(r.team_name)}</td>
          <td class="col-domain">${escapeHtml(r.problem_domain)}</td>
          <td class="col-leader">
            <div class="leader-name">${escapeHtml(r.leader_name)}</div>
            <div class="leader-sub">${escapeHtml(r.leader_email)} &bull; ${escapeHtml(r.leader_phone)}</div>
          </td>
          <td class="col-college">${escapeHtml(r.leader_college)}</td>
          <td class="col-year mono">${escapeHtml(r.leader_year)}</td>
          <td class="col-members mono">
            <span class="member-pill">${memberCount} ${memberCount === 1 ? 'MEMBER' : 'MEMBERS'}</span>
          </td>
          <td class="col-date mono">${formattedDate}</td>
        </tr>
      `;
    }).join('');

    // Attach click handlers for detail view
    tbody.querySelectorAll('tr').forEach(row => {
      row.addEventListener('click', () => {
        const id = row.getAttribute('data-id');
        const reg = registrations.find(r => r.id === id);
        if (reg) openDetailModal(reg);
      });
    });
  }

  // ── Detail Modal (Redesigned Editorial Dossier View) ─────────────────────
  function openDetailModal(r: Registration) {
    if (!r || !detailModal || !modalTeamName || !modalBody) return;

    selectedRegistration = r;
    modalTeamName.textContent = selectedRegistration.team_name;

    // Calculate total team size
    let totalMembers = 1;
    if (selectedRegistration.member_2_name && selectedRegistration.member_2_name.trim()) totalMembers++;
    if (selectedRegistration.member_3_name && selectedRegistration.member_3_name.trim()) totalMembers++;
    if (selectedRegistration.member_4_name && selectedRegistration.member_4_name.trim()) totalMembers++;

    const membersText = `${totalMembers} ${totalMembers === 1 ? 'MEMBER' : 'MEMBERS'}`;

    const formattedDate = new Date(selectedRegistration.created_at).toLocaleString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });

    // Helper for additional member blocks
    const renderMemberCard = (label: string, name?: string | null, email?: string | null, phone?: string | null) => {
      if (!name || !name.trim()) return '';

      const emailHtml = email && email.trim() 
        ? `<a href="mailto:${escapeHtml(email)}" class="field-val link-contact">${escapeHtml(email)} <span class="contact-arrow">↗</span></a>`
        : `<span class="field-val muted">—</span>`;

      const phoneHtml = phone && phone.trim()
        ? `<a href="tel:${escapeHtml(phone)}" class="field-val link-contact">${escapeHtml(phone)} <span class="contact-arrow">↗</span></a>`
        : `<span class="field-val muted">—</span>`;

      return `
        <div class="member-card">
          <div class="member-card-subhead mono">${label}</div>
          <div class="dossier-grid">
            <div class="dossier-field full">
              <span class="field-lbl">FULL NAME</span>
              <span class="field-val highlight">${escapeHtml(name)}</span>
            </div>
            <div class="dossier-field">
              <span class="field-lbl">EMAIL</span>
              ${emailHtml}
            </div>
            <div class="dossier-field">
              <span class="field-lbl">PHONE</span>
              ${phoneHtml}
            </div>
          </div>
        </div>
      `;
    };

    let memberCardsHtml = '';
    memberCardsHtml += renderMemberCard('MEMBER 02', selectedRegistration.member_2_name, selectedRegistration.member_2_email, selectedRegistration.member_2_phone);
    memberCardsHtml += renderMemberCard('MEMBER 03', selectedRegistration.member_3_name, selectedRegistration.member_3_email, selectedRegistration.member_3_phone);
    memberCardsHtml += renderMemberCard('MEMBER 04', selectedRegistration.member_4_name, selectedRegistration.member_4_email, selectedRegistration.member_4_phone);

    const membersSectionContent = memberCardsHtml 
      ? `<div class="members-stack">${memberCardsHtml}</div>`
      : `<p class="empty-members-text mono">1 MEMBER &bull; LEADER ONLY</p>`;

    modalBody.innerHTML = `
      <!-- Team Identity Block -->
      <div class="dossier-section identity-section">
        <div class="identity-grid">
          <div class="identity-block">
            <span class="field-lbl">PROBLEM DOMAIN</span>
            <span class="domain-val">${escapeHtml(selectedRegistration.problem_domain)}</span>
          </div>
          <div class="identity-block">
            <span class="field-lbl">REGISTRATION DATE</span>
            <span class="meta-val mono">${formattedDate}</span>
          </div>
          <div class="identity-block">
            <span class="field-lbl">TEAM SIZE</span>
            <span class="meta-val mono">${membersText}</span>
          </div>
        </div>
      </div>

      <!-- 01 / Team Leader Section -->
      <div class="dossier-section">
        <div class="section-badge mono">01 / TEAM LEADER</div>
        <div class="dossier-grid">
          <div class="dossier-field">
            <span class="field-lbl">FULL NAME</span>
            <span class="field-val highlight">${escapeHtml(selectedRegistration.leader_name)}</span>
          </div>
          <div class="dossier-field">
            <span class="field-lbl">YEAR OF STUDY</span>
            <span class="field-val">${escapeHtml(selectedRegistration.leader_year)}</span>
          </div>
          <div class="dossier-field">
            <span class="field-lbl">EMAIL</span>
            <a href="mailto:${escapeHtml(selectedRegistration.leader_email)}" class="field-val link-contact">
              ${escapeHtml(selectedRegistration.leader_email)} <span class="contact-arrow">↗</span>
            </a>
          </div>
          <div class="dossier-field">
            <span class="field-lbl">PHONE</span>
            <a href="tel:${escapeHtml(selectedRegistration.leader_phone)}" class="field-val link-contact">
              ${escapeHtml(selectedRegistration.leader_phone)} <span class="contact-arrow">↗</span>
            </a>
          </div>
          <div class="dossier-field full">
            <span class="field-lbl">COLLEGE / INSTITUTION</span>
            <span class="field-val">${escapeHtml(selectedRegistration.leader_college)}</span>
          </div>
        </div>
      </div>

      <!-- 02 / Team Members Section -->
      <div class="dossier-section">
        <div class="section-badge mono">02 / TEAM MEMBERS</div>
        ${membersSectionContent}
      </div>
    `;

    detailModal.hidden = false;
    detailModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDetailModal() {
    selectedRegistration = null;
    if (!detailModal) return;
    detailModal.hidden = true;
    detailModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // ── Event Listeners ────────────────────────────────────────────────────────
  if (searchInput) searchInput.addEventListener('input', applyFiltersAndSort);
  if (domainFilter) domainFilter.addEventListener('change', applyFiltersAndSort);
  if (sortSelect) sortSelect.addEventListener('change', applyFiltersAndSort);

  if (btnRetry) btnRetry.addEventListener('click', fetchRegistrations);

  if (btnCloseModal) btnCloseModal.addEventListener('click', closeDetailModal);
  if (modalBackdrop) modalBackdrop.addEventListener('click', closeDetailModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && detailModal && !detailModal.hidden) {
      closeDetailModal();
    }
  });

  if (btnSignOut) {
    btnSignOut.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/admin/login';
    });
  }

  // Run initialization
  initAdminDashboard();
</script>
