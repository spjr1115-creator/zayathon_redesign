</style>

<script>
  import { getSupabase } from '../lib/supabase';

  // ── Supabase client ──────────────────────────────────────────────────────────
  const supabase = getSupabase();

  // ── State ────────────────────────────────────────────────────────────────────
  // FALSE on every fresh page load — success HTML does NOT exist in the DOM yet.
  let submissionSuccessful = false;

  // ── Dynamic member add / remove ──────────────────────────────────────────────
  const btnAddMember = document.getElementById('btn-add-member');

  if (btnAddMember) {
    btnAddMember.addEventListener('click', () => {
      const hiddenMember = document.querySelector('.member-group[style*="display: none"]');
      if (hiddenMember) {
        (hiddenMember as HTMLElement).style.display = 'flex';
        updateAddMemberButton();
        const memberNum = hiddenMember.id.replace('member-group-', '');
        const liveStatus = document.getElementById('member-live-status');
        if (liveStatus) liveStatus.textContent = `Member ${memberNum} added.`;
        const firstInput = hiddenMember.querySelector('input') as HTMLInputElement | null;
        if (firstInput) firstInput.focus();
      }
    });
  }

  function updateAddMemberButton() {
    if (!btnAddMember) return;
    const visibleMembers = document.querySelectorAll(
      '.member-group[style="display: flex;"], .member-group:not([style*="display: none"])'
    );
    if (visibleMembers.length >= 3) {
      (btnAddMember as HTMLElement).style.display = 'none';
    } else {
      (btnAddMember as HTMLElement).style.display = 'block';
      btnAddMember.innerHTML = visibleMembers.length === 0
        ? '+ ADD TEAM MEMBER'
        : '+ ADD ANOTHER MEMBER';
    }
  }

  document.querySelectorAll('.btn-remove-member').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget as HTMLButtonElement;
      const memberId  = targetBtn.getAttribute('data-member');
      const group     = document.getElementById(`member-group-${memberId}`);
      if (group) {
        group.style.display = 'none';
        group.querySelectorAll('input').forEach(input => (input as HTMLInputElement).value = '');
        updateAddMemberButton();
        const liveStatus = document.getElementById('member-live-status');
        if (liveStatus) liveStatus.textContent = `Member ${memberId} removed.`;
        if (btnAddMember) btnAddMember.focus();
      }
    });
  });

  // ── Scroll-spy progress tracker ──────────────────────────────────────────────
  const sections      = document.querySelectorAll('.form-section');
  const progressItems = document.querySelectorAll('.progress-list li');

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const stepNum = parseInt(
          entry.target.getAttribute('id')?.replace('section-', '') || '1', 10
        );
        progressItems.forEach(item => {
          const itemStep = parseInt(item.getAttribute('data-step') || '1', 10);
          item.classList.remove('active', 'completed');
          if (itemStep === stepNum)       item.classList.add('active');
          else if (itemStep < stepNum)    item.classList.add('completed');
        });
      }
    });
  }, { root: null, rootMargin: '-20% 0px -60% 0px', threshold: 0 });

  sections.forEach(section => sectionObserver.observe(section));

  // ── HTML Escape Helper ────────────────────────────────────────────────────────
  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, char => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[char]!));
  }

  // ── renderSuccess ────────────────────────────────────────────────────────────
  // Called ONLY after confirmed Supabase INSERT (error === null).
  // Dynamically injects the success screen — it never exists in the DOM before this.
  function renderSuccess(
    teamName: string,
    domain: string,
    leaderName: string,
    additionalMemberCount: number
  ) {
    const registrationPage = document.querySelector('.registration-page') as HTMLElement;
    if (!registrationPage) return;

    const safeTeamName = escapeHtml(teamName);
    const safeDomain = escapeHtml(domain);
    const safeLeaderName = escapeHtml(leaderName);

    // Total members = leader + additional
    const totalMembers = additionalMemberCount + 1;
    const membersText  = `${totalMembers} MEMBER${totalMembers > 1 ? 'S' : ''}`;

    // Wipe everything from the page body (form, header, etc.)
    registrationPage.innerHTML = '';

    // Inject the new premium success screen — only now does it exist on the page
    registrationPage.innerHTML = `
      <div class="sc-page" id="success-view" aria-live="polite">

        <!-- Barely-visible watermark 'Z' -->
        <span class="sc-watermark" aria-hidden="true">Z</span>

        <!-- Top navigation -->
        <nav class="sc-nav">
          <span class="sc-nav-brand">ZAYATHON</span>
          <a href="/" class="sc-nav-back">
            <span class="sc-back-arrow">&#x2190;</span>
            BACK TO ZAYATHON
          </a>
        </nav>

        <!-- Two-column editorial layout -->
        <main class="sc-main">

          <!-- LEFT: headline copy -->
          <div class="sc-left">
            <p class="sc-label">REGISTRATION COMPLETE</p>
            <h1 class="sc-hero" id="sc-hero" tabindex="-1">YOU&#x2019;RE<br>IN.</h1>
            <p class="sc-tagline">Your team registration has been received.</p>
            <p class="sc-tagline-strong">Now it&#x2019;s time to build.</p>
          </div>

          <!-- RIGHT: checkmark + summary -->
          <div class="sc-right">

            <!-- Animated checkmark -->
            <div class="sc-check" aria-label="Registration confirmed">
              <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
                <circle
                  cx="28" cy="28" r="25"
                  stroke="var(--blue, #1d4ed8)" stroke-width="1.4"
                  stroke-dasharray="157" stroke-dashoffset="157"
                  class="sc-circle" />
                <path
                  d="M18 28l8 8 14-14"
                  stroke="var(--blue, #1d4ed8)" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"
                  stroke-dasharray="42" stroke-dashoffset="42"
                  class="sc-check-path" />
              </svg>
            </div>

            <!-- Registration summary -->
            <div class="sc-summary">
              <div class="sc-summary-row">
                <span class="sc-summary-label">TEAM</span>
                <span class="sc-summary-val">${safeTeamName.toUpperCase()}</span>
              </div>
              <div class="sc-summary-row">
                <span class="sc-summary-label">DOMAIN</span>
                <span class="sc-summary-val">${safeDomain.toUpperCase()}</span>
              </div>
              <div class="sc-summary-row">
                <span class="sc-summary-label">TEAM LEADER</span>
                <span class="sc-summary-val">${safeLeaderName.toUpperCase()}</span>
              </div>
              <div class="sc-summary-row">
                <span class="sc-summary-label">MEMBERS</span>
                <span class="sc-summary-val">${membersText}</span>
              </div>
            </div>

          </div>
        </main>

        <!-- Bottom section -->
        <div class="sc-bottom">

          <!-- Animated horizontal rule -->
          <div class="sc-ruler" aria-hidden="true">
            <div class="sc-ruler-line"></div>
            <span class="sc-ruler-label">ZAYATHON 2026</span>
          </div>

          <p class="sc-closing">WE&#x2019;LL SEE YOU AT ZAYATHON.</p>
          <p class="sc-sub-closing">Build something worth remembering.</p>

          <div class="sc-actions">
            <a href="/" class="sc-cta">
              BACK TO ZAYATHON
              <span class="sc-cta-arrow">&#x2197;</span>
            </a>
            <button type="button" class="sc-contact-link" id="sc-contact-btn">
              Need help? Contact the ZAYATHON team &#x2192;
            </button>
          </div>

        </div>

        <!-- Footer -->
        <footer class="sc-footer">
          <div class="sc-footer-inner">
            <span>ZAYATHON 2026 &middot; ZAYA CODE HUB</span>
            <span>SALEM, TAMIL NADU &middot; INDIA</span>
            <span>&copy; 2026 ZAYA CODE HUB</span>
          </div>
        </footer>

      </div>`;

    // Wire up the contact panel trigger
    const scContactBtn = document.getElementById('sc-contact-btn');
    if (scContactBtn) {
      scContactBtn.addEventListener('click', () => {
        const fcTrigger = document.getElementById('fc-trigger') as HTMLButtonElement | null;
        if (fcTrigger) fcTrigger.click();
      });
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
    document.getElementById('sc-hero')?.focus();
  }

  // ── Form submission ──────────────────────────────────────────────────────────
  const form      = document.getElementById('zayathon-reg-form') as HTMLFormElement;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
  const errorBox  = document.getElementById('form-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Guard: prevent double-submit
      if (submissionSuccessful) return;

      // Hide previous errors
      if (errorBox) errorBox.hidden = true;

      // Loading state
      const originalBtnContent = btnSubmit.innerHTML;
      btnSubmit.disabled  = true;
      btnSubmit.setAttribute('aria-busy', 'true');
      btnSubmit.innerHTML = 'SUBMITTING...';

      // Collect values — saved here so success screen can use them
      const formData   = new FormData(form);
      const teamName   = String(formData.get('team_name')      || '');
      const domain     = String(formData.get('problem_domain') || '');
      const leaderName = String(formData.get('leader_name')    || '');

      // Count visible additional members (beyond the leader)
      const additionalMemberCount = document.querySelectorAll(
        '.member-group:not([style*="display: none"])'
      ).length;

      const payload = {
        team_name:      teamName,
        problem_domain: domain,
        leader_name:    leaderName,
        leader_email:   formData.get('leader_email'),
        leader_phone:   formData.get('leader_phone'),
        leader_college: formData.get('leader_college'),
        leader_year:    formData.get('leader_year'),
        member_2_name:  formData.get('member_2_name')  || null,
        member_2_email: formData.get('member_2_email') || null,
        member_2_phone: formData.get('member_2_phone') || null,
        member_3_name:  formData.get('member_3_name')  || null,
        member_3_email: formData.get('member_3_email') || null,
        member_3_phone: formData.get('member_3_phone') || null,
        member_4_name:  formData.get('member_4_name')  || null,
        member_4_email: formData.get('member_4_email') || null,
        member_4_phone: formData.get('member_4_phone') || null,
      };

      try {
        // INSERT only — no .select(), participant data never read back
        const { error } = await supabase
          .from('registrations')
          .insert([payload]);

        if (error) throw error;

        // ── error === null → INSERT confirmed ────────────────────────────────
        submissionSuccessful = true;

        // Only NOW create the success screen in the DOM
        renderSuccess(teamName, domain, leaderName, additionalMemberCount);

      } catch (err: any) {
        // ── INSERT failed → submissionSuccessful stays false ─────────────────
        // Form remains visible. Success screen is never rendered.
        submissionSuccessful = false;
        console.error('Submission Error:', err);
        if (errorBox) {
          let errorMessage = "REGISTRATION FAILED\n\nSomething went wrong while submitting your registration.\nPlease try again.";
          
          if (err && err.code === '23505') {
            const errMsg = err.message || '';
            if (errMsg.includes('registrations_team_name_unique')) {
              errorMessage = "TEAM ALREADY REGISTERED\n\nA team with this name has already registered.\nPlease use a different team name.";
            } else if (errMsg.includes('registrations_leader_email_unique')) {
              errorMessage = "LEADER EMAIL ALREADY REGISTERED\n\nThis email is already associated with a ZAYATHON registration.\nPlease check the leader details.";
            }
          }
          
          errorBox.textContent = errorMessage;
          errorBox.setAttribute('role', 'alert');
          errorBox.setAttribute('tabindex', '-1');
          errorBox.hidden = false;
          errorBox.focus();
        }
        btnSubmit.disabled  = false;
        btnSubmit.removeAttribute('aria-busy');
        btnSubmit.innerHTML = originalBtnContent;
      }
    });
  }
</script>

