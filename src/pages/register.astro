---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Main Registration Container -->
  <main class="registration-page">
    
    <!-- Header -->
    <header class="reg-header">
      <div class="header-inner container-wide">
        <span class="reg-brand">ZAYATHON</span>
        <a href="/" class="back-link">
          <span class="arrow">←</span> BACK TO ZAYATHON
        </a>
      </div>
    </header>

    <div class="container reg-content">
      
      <!-- Intro Section -->
      <div class="reg-intro" data-reveal>
        <p class="section-label">ZAYATHON 2026 / REGISTRATION</p>
        <h1 class="reg-title">LET'S BUILD.</h1>
        <p class="reg-desc">Register your team and step into the arena.</p>
        <p class="reg-meta mono">Teams of up to 4 members • Students from 1st–3rd year</p>
      </div>

      <!-- Two Column Layout for Form -->
      <div class="reg-layout" id="form-view">
        
        <!-- Left: Progress -->
        <aside class="reg-sidebar" data-reveal style="--d: 150ms;">
          <div class="sidebar-sticky">
            <ul class="progress-list mono" id="progress-tracker">
              <li class="active" data-step="1">01 TEAM</li>
              <li data-step="2">02 LEADER</li>
              <li data-step="3">03 MEMBERS</li>
              <li data-step="4">04 CONFIRM</li>
            </ul>
          </div>
        </aside>

        <!-- Right: Form -->
        <div class="reg-form-wrapper" data-reveal style="--d: 300ms;">
          <form class="reg-form" id="zayathon-reg-form">
            
            <!-- SECTION 1: TEAM -->
            <fieldset class="form-section" id="section-1">
              <div class="section-header">
                <span class="section-num mono">01 / TEAM</span>
                <legend class="section-heading">YOUR TEAM</legend>
                <p class="section-explain">Tell us what you're building.</p>
              </div>
              
              <div class="fields-container">
                <div class="field-group">
                  <label for="team_name">TEAM NAME <span class="req" aria-hidden="true">*</span></label>
                  <input type="text" id="team_name" name="team_name" required aria-required="true" autocomplete="organization" placeholder="Enter team name" />
                </div>
                
                <div class="field-group">
                  <label for="problem_domain">PROBLEM DOMAIN <span class="req" aria-hidden="true">*</span></label>
                  <div class="select-wrapper">
                    <select id="problem_domain" name="problem_domain" required aria-required="true">
                      <option value="" disabled selected>Select a domain</option>
                      <option value="Agentic AI">Agentic AI</option>
                      <option value="Robotics & Autonomous Systems">Robotics & Autonomous Systems</option>
                      <option value="Cybersecurity & Threat Intelligence">Cybersecurity & Threat Intelligence</option>
                      <option value="HealthTech & MedAI">HealthTech & MedAI</option>
                      <option value="FinTech & Blockchain">FinTech & Blockchain</option>
                      <option value="Smart Cities & IoT">Smart Cities & IoT</option>
                      <option value="Agritech & Rural Innovation">Agritech & Rural Innovation</option>
                      <option value="Transportation & Logistics">Transportation & Logistics</option>
                      <option value="Open Innovation">Open Innovation</option>
                    </select>
                    <svg class="select-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                  </div>
                </div>
              </div>
            </fieldset>

            <hr class="section-divider" />

            <!-- SECTION 2: LEADER -->
            <fieldset class="form-section" id="section-2">
              <div class="section-header">
                <span class="section-num mono">02 / LEADER</span>
                <legend class="section-heading">TEAM LEADER</legend>
                <p class="section-explain">The person representing your team.</p>
              </div>

              <div class="fields-container">
                <div class="field-group">
                  <label for="leader_name">FULL NAME <span class="req" aria-hidden="true">*</span></label>
                  <input type="text" id="leader_name" name="leader_name" required aria-required="true" autocomplete="name" placeholder="Leader's full name" />
                </div>
                
                <div class="field-group">
                  <label for="leader_email">EMAIL <span class="req" aria-hidden="true">*</span></label>
                  <input type="email" id="leader_email" name="leader_email" required aria-required="true" autocomplete="email" placeholder="leader@example.com" />
                </div>
                
                <div class="field-group">
                  <label for="leader_phone">PHONE NUMBER <span class="req" aria-hidden="true">*</span></label>
                  <input type="tel" id="leader_phone" name="leader_phone" required aria-required="true" autocomplete="tel" placeholder="10-digit number" pattern="[0-9]{10}" title="Please enter exactly 10 digits" />
                </div>

                <div class="field-group">
                  <label for="leader_college">COLLEGE / INSTITUTION <span class="req" aria-hidden="true">*</span></label>
                  <input type="text" id="leader_college" name="leader_college" required aria-required="true" autocomplete="organization" placeholder="Full college name" />
                </div>

                <div class="field-group">
                  <label for="leader_year">YEAR OF STUDY <span class="req" aria-hidden="true">*</span></label>
                  <div class="select-wrapper">
                    <select id="leader_year" name="leader_year" required aria-required="true">
                      <option value="" disabled selected>Select year</option>
                      <option value="1st Year">1st Year</option>
                      <option value="2nd Year">2nd Year</option>
                      <option value="3rd Year">3rd Year</option>
                    </select>
                    <svg class="select-arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                  </div>
                </div>
              </div>
            </fieldset>

            <hr class="section-divider" />

            <!-- SECTION 3: MEMBERS -->
            <fieldset class="form-section" id="section-3">
              <div class="section-header">
                <span class="section-num mono">03 / MEMBERS</span>
                <legend class="section-heading">TEAM MEMBERS</legend>
                <p class="section-explain">Add up to 3 additional members.</p>
              </div>
              
              <div class="fields-container">
                  <!-- Members will be revealed here via JS -->
                  <div class="member-group" id="member-group-2" style="display: none;">
                    <div class="member-header">
                      <span class="member-label">MEMBER 2</span>
                      <button type="button" class="btn-remove-member" data-member="2">REMOVE</button>
                    </div>
                    <div class="fields-container">
                      <div class="field-group">
                        <label for="member_2_name">FULL NAME <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" id="member_2_name" name="member_2_name" autocomplete="name" placeholder="Member's full name" />
                      </div>
                      <div class="field-group">
                        <label for="member_2_email">EMAIL <span class="req" aria-hidden="true">*</span></label>
                        <input type="email" id="member_2_email" name="member_2_email" autocomplete="email" placeholder="member@example.com" />
                      </div>
                      <div class="field-group">
                        <label for="member_2_phone">PHONE NUMBER <span class="req" aria-hidden="true">*</span></label>
                        <input type="tel" id="member_2_phone" name="member_2_phone" autocomplete="tel" placeholder="10-digit number" pattern="[0-9]{10}" />
                      </div>
                    </div>
                  </div>
                  
                  <div class="member-group" id="member-group-3" style="display: none;">
                    <div class="member-header">
                      <span class="member-label">MEMBER 3</span>
                      <button type="button" class="btn-remove-member" data-member="3">REMOVE</button>
                    </div>
                    <div class="fields-container">
                      <div class="field-group">
                        <label for="member_3_name">FULL NAME <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" id="member_3_name" name="member_3_name" autocomplete="name" placeholder="Member's full name" />
                      </div>
                      <div class="field-group">
                        <label for="member_3_email">EMAIL <span class="req" aria-hidden="true">*</span></label>
                        <input type="email" id="member_3_email" name="member_3_email" autocomplete="email" placeholder="member@example.com" />
                      </div>
                      <div class="field-group">
                        <label for="member_3_phone">PHONE NUMBER <span class="req" aria-hidden="true">*</span></label>
                        <input type="tel" id="member_3_phone" name="member_3_phone" autocomplete="tel" placeholder="10-digit number" pattern="[0-9]{10}" />
                      </div>
                    </div>
                  </div>

                  <div class="member-group" id="member-group-4" style="display: none;">
                    <div class="member-header">
                      <span class="member-label">MEMBER 4</span>
                      <button type="button" class="btn-remove-member" data-member="4">REMOVE</button>
                    </div>
                    <div class="fields-container">
                      <div class="field-group">
                        <label for="member_4_name">FULL NAME <span class="req" aria-hidden="true">*</span></label>
                        <input type="text" id="member_4_name" name="member_4_name" autocomplete="name" placeholder="Member's full name" />
                      </div>
                      <div class="field-group">
                        <label for="member_4_email">EMAIL <span class="req" aria-hidden="true">*</span></label>
                        <input type="email" id="member_4_email" name="member_4_email" autocomplete="email" placeholder="member@example.com" />
                      </div>
                      <div class="field-group">
                        <label for="member_4_phone">PHONE NUMBER <span class="req" aria-hidden="true">*</span></label>
                        <input type="tel" id="member_4_phone" name="member_4_phone" autocomplete="tel" placeholder="10-digit number" pattern="[0-9]{10}" />
                      </div>
                    </div>
                  </div>

                <div id="member-live-status" class="sr-only" aria-live="polite"></div>

                <button type="button" class="btn-add-member mono" id="btn-add-member">
                  + ADD TEAM MEMBER
                </button>
              </div>
            </fieldset>

            <hr class="section-divider" />

            <!-- SECTION 4: CONFIRMATION -->
            <fieldset class="form-section" id="section-4">
              <div class="section-header">
                <span class="section-num mono">04 / CONFIRM</span>
              </div>
              
              <div class="fields-container">
                <div class="checkbox-group">
                  <input type="checkbox" id="confirmation" name="confirmation" required />
                  <label for="confirmation">
                    I confirm that the information provided is accurate and that my team meets the ZAYATHON eligibility requirements.
                  </label>
                </div>
                
                <!-- Error Message Box -->
                <div id="form-error" class="form-error" aria-live="assertive" hidden>
                  REGISTRATION FAILED

Something went wrong while submitting your registration.
Please try again.
                </div>

                <button type="submit" class="btn-submit" id="btn-submit">
                  SUBMIT REGISTRATION <span class="arrow">↗</span>
                </button>
              </div>
            </fieldset>

          </form>
        </div>
      </div>

    </div>
  </main>
</BaseLayout>

<style>
  /* Base Page Styles */
  .registration-page {
    background-color: #F0F0EE;
    color: #111111;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  .reg-header {
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    padding: 24px 0;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .reg-brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: #777777;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 300ms ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .back-link .arrow {
    transition: transform 300ms ease;
  }

  .back-link:hover {
    color: var(--blue);
  }

  .back-link:hover .arrow {
    transform: translateX(-4px);
  }

  /* Content Area */
  .reg-content {
    flex: 1;
    padding-top: clamp(60px, 8vh, 100px);
    padding-bottom: clamp(100px, 15vh, 140px);
  }

  .reg-intro {
    max-width: 700px;
    margin-bottom: clamp(60px, 10vh, 100px);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #777777;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .reg-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #111111;
    margin-bottom: 24px;
  }

  .reg-desc {
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    color: #111111;
    margin-bottom: 16px;
  }

  .reg-meta {
    font-size: 0.8rem;
    color: #777777;
  }

  /* Two Column Layout */
  .reg-layout {
    display: flex;
    flex-direction: row;
    gap: clamp(40px, 8vw, 120px);
    align-items: flex-start;
  }

  /* Sidebar Tracker */
  .reg-sidebar {
    flex: 0 0 200px;
  }
  
  .sidebar-sticky {
    position: sticky;
    top: 40px;
  }

  .progress-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .progress-list li {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: #999999; /* Upcoming */
    transition: color 300ms ease;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .progress-list li.completed {
    color: #111111;
  }
  
  .progress-list li.completed::after {
    content: '✓';
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #111111;
    opacity: 0.7;
  }

  .progress-list li.active {
    color: var(--blue);
    font-weight: 600;
  }
  
  .progress-list li.active::after {
    content: none;
  }

  /* Form */
  .reg-form-wrapper {
    flex: 1;
    max-width: 680px;
  }

  .reg-form {
    display: flex;
    flex-direction: column;
  }

  .form-section {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .section-divider {
    border: none;
    border-top: 1px solid rgba(17, 17, 17, 0.12);
    margin: clamp(60px, 10vh, 100px) 0;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-num {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #777777;
    text-transform: uppercase;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #111111;
  }

  .section-explain {
    font-size: 1rem;
    color: #777777;
  }
  
  .fields-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Fields */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 10px; /* 8-10px gap between label and input */
    width: 100%;
  }

  label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: #555555;
    text-transform: uppercase;
  }

  .req {
    color: var(--blue);
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  select {
    width: 100%;
    background-color: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 10px;
    height: 56px;
    padding: 0 16px;
    font-size: 16px;
    font-family: var(--font-sans);
    color: #111111;
    transition: border-color 300ms ease, box-shadow 300ms ease;
    -webkit-appearance: none;
    appearance: none;
  }

  input:focus, select:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
  }

  input::placeholder {
    color: #999999;
  }

  /* Select specific */
  .select-wrapper {
    position: relative;
  }

  .select-arrow {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #777777;
    pointer-events: none;
  }

  /* Add Member Button */
  .btn-add-member {
    align-self: flex-start;
    background: transparent;
    border: 1px dashed rgba(17, 17, 17, 0.2);
    border-radius: 10px;
    color: #111111;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    padding: 16px 24px;
    cursor: pointer;
    transition: border-color 300ms ease, color 300ms ease;
  }

  .btn-add-member:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  /* Member Card/Group */
  .member-group {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 80px;
    animation: fadeSlideIn 400ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  
  .member-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0;
  }

  .member-label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #111111;
    text-transform: uppercase;
  }
  
  .btn-remove-member {
    background: transparent;
    border: none;
    color: #777777;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    text-transform: uppercase;
    transition: color 300ms ease;
  }

  .btn-remove-member:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  /* Checkbox */
  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .checkbox-group input[type="checkbox"] {
    margin-top: 4px;
    width: 24px;
    height: 24px;
    accent-color: var(--blue);
    flex-shrink: 0;
  }

  .checkbox-group label {
    font-family: var(--font-sans);
    text-transform: none;
    letter-spacing: 0;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: #111111;
    cursor: pointer;
  }

  /* Error Box */
  .form-error {
    color: #dc2626;
    font-size: 0.95rem;
    margin-top: 20px;
    white-space: pre-line;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Submit Button */
  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: 40px;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    background: #111111;
    border: none;
    height: 60px;
    border-radius: 10px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 250ms ease, transform 250ms ease;
  }

  .btn-submit .arrow {
    font-family: var(--font-mono);
    font-size: 1.1em;
    transition: transform 300ms ease;
  }

  .btn-submit:hover:not(:disabled) {
    background: #333333;
  }

  .btn-submit:hover:not(:disabled) .arrow {
    transform: translateX(4px);
  }

  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Success View */
  .success-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 60vh;
    animation: fadeIn 600ms ease forwards;
  }

  .success-inner {
    max-width: 600px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .success-icon {
    width: 80px;
    height: 80px;
    color: var(--blue);
    margin: 40px 0;
  }

  .success-icon.animate .draw-circle {
    animation: drawCircle 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  
  .success-icon.animate .draw-check {
    animation: drawCheck 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.6s forwards;
  }

  .success-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #111111;
    margin-bottom: 20px;
  }

  .success-desc {
    font-size: 1.2rem;
    color: #555555;
    margin-bottom: 60px;
  }

  .success-details {
    width: 100%;
    background: #FFFFFF;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 10px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
    margin-bottom: 40px;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed rgba(17, 17, 17, 0.1);
    padding-bottom: 8px;
  }
  .detail-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .detail-label {
    font-size: 0.7rem;
    color: #777777;
    letter-spacing: 0.1em;
  }
  .detail-val {
    font-size: 0.85rem;
    color: #111111;
    font-weight: 600;
  }

  .success-footer {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #111111;
  }
  
  .btn-return {
    margin-top: 40px; 
    width: auto;
    padding: 0 40px;
  }

  /* Animations */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUpRow 600ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes fadeUpRow {
    to { opacity: 1; transform: none; }
  }

  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes drawCircle {
    to { stroke-dashoffset: 0; }
  }
  @keyframes drawCheck {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal], .member-group, .success-view, .draw-circle, .draw-check {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
      stroke-dashoffset: 0 !important;
    }
  }

  /* Mobile tweaks */
  @media (max-width: 768px) {
    .reg-layout {
      flex-direction: column;
      gap: 40px;
    }
    
    .reg-sidebar {
      position: static;
      flex: none;
      width: 100%;
